<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:label="Work Tracker" >
		<!-- have google play services download the OCR model with the app so
		     receipt scanning works offline straight away -->
		<meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="ocr" />
	</application>

	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.SEND_SMS" />
	<!-- filling a customer's name and number in from the phone's contacts -->
	<uses-permission android:name="android.permission.READ_CONTACTS" />
	<!-- taking receipt photos with MediaPicker -->
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
	<uses-feature android:name="android.hardware.camera" android:required="false" />
	<!-- from android 11 an app cannot see other apps unless it says which
	     kinds it needs. without these the messaging and mail apps look as
	     though they are not installed and texting a customer fails with
	     "not supported on this device" -->
	<queries>
		<intent>
			<action android:name="android.media.action.IMAGE_CAPTURE" />
		</intent>
		<!-- texting a customer -->
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:scheme="smsto" />
		</intent>
		<intent>
			<action android:name="android.intent.action.SENDTO" />
			<data android:scheme="smsto" />
		</intent>
		<!-- emailing a customer -->
		<intent>
			<action android:name="android.intent.action.SENDTO" />
			<data android:scheme="mailto" />
		</intent>
		<!-- ringing a customer -->
		<intent>
			<action android:name="android.intent.action.DIAL" />
			<data android:scheme="tel" />
		</intent>
		<!-- opening the google sign in page and sharing exports -->
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:scheme="https" />
		</intent>
		<intent>
			<action android:name="android.intent.action.SEND" />
			<data android:mimeType="*/*" />
		</intent>
	</queries>
	<uses-sdk android:minSdkVersion="21" android:targetSdkVersion="31"/>
</manifest>
