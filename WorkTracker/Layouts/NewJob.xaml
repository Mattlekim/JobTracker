<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UiInterface.Layouts.NewJob"
             x:Name="cp_title"
             Title="NewJob">

    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F2F4F7, Dark=#1E1E1E}" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Caption" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
        </Style>
    </ContentPage.Resources>

    <StackLayout>

        <Grid Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="_bnt_Delete" Text="Delete" Clicked="bnt_Delete" HorizontalOptions="Start" BackgroundColor="Transparent" BorderWidth="2" BorderColor="#E53935" TextColor="#E53935" CornerRadius="8" Padding="16,6"></Button>
            <Button Grid.Column="1" x:Name="_bnt_Add" Text="Create Job" Clicked="bnt_Add" HorizontalOptions="End" BackgroundColor="#2E7D32" TextColor="White" FontAttributes="Bold" CornerRadius="8" Padding="16,6"></Button>
        </Grid>

        <ScrollView x:Name="sv_mainScrole" VerticalOptions="FillAndExpand" HorizontalScrollBarVisibility="Default">
            <VerticalStackLayout Padding="16,4,16,24" Spacing="12">

                <!-- hidden legacy field, still read by the code behind -->
                <Entry x:Name="t_description" IsVisible="false"></Entry>

                <!--  JOB  -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="l_jobSection" Text="Job" Style="{StaticResource SectionTitle}" />
                        <!-- a quote is only priced up work, so the form drops
                             to what pricing it needs -->
                        <Label x:Name="l_quoteHint" IsVisible="false" Style="{StaticResource Caption}"
                               Text="Where it is, what it is and what it comes to. When it starts and everything else is asked if the quote is taken up." />

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Job type" Style="{StaticResource Caption}" />
                            <Picker x:Name="p_JobType"></Picker>
                        </VerticalStackLayout>

                        <!-- which round the work is on. the list is set up on
                             the settings page; No Round is always offered -->
                        <VerticalStackLayout x:Name="vsl_round" Spacing="2">
                            <Label Text="Round" Style="{StaticResource Caption}" />
                            <Picker x:Name="p_round"></Picker>
                        </VerticalStackLayout>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Price" Style="{StaticResource Caption}" />
                                <Entry x:Name="t_price" Keyboard="Numeric"></Entry>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label x:Name="l_repeats" Text="Repeats every" Style="{StaticResource Caption}" />
                                <!-- a one off has nothing to repeat, so the how
                                     often boxes go away rather than sit there
                                     showing a figure that is not used -->
                                <HorizontalStackLayout x:Name="hsl_frequency" Spacing="6">
                                    <Entry x:Name="e_frequence" Keyboard="Numeric" MinimumWidthRequest="60"></Entry>
                                    <Picker x:Name="p_frequencyType" SelectedIndex="0" VerticalOptions="Center">
                                        <Picker.Items>
                                            <x:String>Day</x:String>
                                            <x:String>Week</x:String>
                                            <x:String>Month</x:String>
                                            <x:String>Year</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="4">
                                    <CheckBox x:Name="cb_oneOff" CheckedChanged="cb_oneOff_Changed" VerticalOptions="Center"></CheckBox>
                                    <Label Text="One off" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label x:Name="l_oneOffNote" Text="Done once, then it is finished. You can put it on again afterwards." Style="{StaticResource Caption}" IsVisible="false" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid x:Name="g_durationAndStart" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Estimated duration (minutes)" Style="{StaticResource Caption}" />
                                <Entry x:Name="e_estimatedDruation" Keyboard="Numeric"></Entry>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Start date" Style="{StaticResource Caption}" />
                                <DatePicker x:Name="dp_startDate" HorizontalOptions="Start"></DatePicker>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Notes" Style="{StaticResource Caption}" />
                            <Entry x:Name="t_notes" Placeholder="Job notes (optional)"></Entry>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="vsl_startingBalance" Spacing="2">
                            <Label x:Name="l_ballence" Text="Starting Balance" Style="{StaticResource Caption}" />
                            <HorizontalStackLayout Spacing="6">
                                <Entry x:Name="e_startingBallence" Keyboard="Numeric" WidthRequest="100"></Entry>
                                <Picker x:Name="p_ballenceType" SelectedIndex="0" VerticalOptions="Center">
                                    <Picker.Items>
                                        <x:String>Credit</x:String>
                                        <x:String>Debt</x:String>
                                    </Picker.Items>
                                </Picker>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Grid x:Name="g_alternativePriceToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="Has an alternative price (e.g. front only)" VerticalOptions="Center" />
                            <CheckBox Grid.Column="1" x:Name="cb_alternativePrice" CheckedChanged="cb_alterativePrice_Checked" BackgroundColor="Transparent"></CheckBox>
                        </Grid>

                        <VerticalStackLayout x:Name="g_alterativePrice" Spacing="10" IsVisible="true">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Alternative name" Style="{StaticResource Caption}" />
                                    <Entry x:Name="e_alterativeName"></Entry>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Alternative price" Style="{StaticResource Caption}" />
                                    <Entry x:Name="e_alterativePrice" Keyboard="Numeric"></Entry>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!--  JOB ADDRESS  -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <!-- the icon fills the street, town, area and postcode
                             in from where the phone is standing. the house
                             number is left alone on purpose -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="Job Address" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                            <ImageButton Grid.Column="1" x:Name="bnt_useLocation" Source="location.png" Clicked="bnt_useLocation_Clicked"
                                         HeightRequest="38" WidthRequest="38" Padding="8" CornerRadius="19" BackgroundColor="#1E88E5" VerticalOptions="Center"></ImageButton>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.35*"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="House no. *" Style="{StaticResource Caption}" />
                                <Entry x:Name="t_houseNumberName"></Entry>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Street *" Style="{StaticResource Caption}" />
                                <Entry x:Name="t_street"></Entry>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- the streets, towns and areas already on the round,
                             offered as they are typed. without these the same
                             street goes in three different ways and splits
                             itself up in every list that groups by street -->
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout x:Name="hsl_streetSuggestions" Spacing="6" Padding="0,2" IsVisible="false"></HorizontalStackLayout>
                        </ScrollView>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="City / Town *" Style="{StaticResource Caption}" />
                                <Entry x:Name="t_city"></Entry>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Area" Style="{StaticResource Caption}" />
                                <Entry x:Name="t_area"></Entry>
                            </VerticalStackLayout>
                        </Grid>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout x:Name="hsl_citySuggestions" Spacing="6" Padding="0,2" IsVisible="false"></HorizontalStackLayout>
                        </ScrollView>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout x:Name="hsl_areaSuggestions" Spacing="6" Padding="0,2" IsVisible="false"></HorizontalStackLayout>
                        </ScrollView>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Postcode" Style="{StaticResource Caption}" />
                            <Entry x:Name="t_postcode" MaximumWidthRequest="200" HorizontalOptions="Start" WidthRequest="200"></Entry>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!--  CUSTOMER  -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="Customer" Style="{StaticResource SectionTitle}" />
                            <Button Grid.Column="1" Text="Help?" Padding="8,2" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1E88E5, Dark=#64B5F6}" Clicked="bnt_existingCustomerHelp_Clicked"></Button>
                        </Grid>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Link to existing customer (optional)" Style="{StaticResource Caption}" />
                            <Picker x:Name="p_customer" SelectedIndexChanged="p_customerSelected"></Picker>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Name" Style="{StaticResource Caption}" />
                            <Entry x:Name="t_customerName"></Entry>
                        </VerticalStackLayout>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Phone" Style="{StaticResource Caption}" />
                                <Entry x:Name="t_customerPhone" Keyboard="Telephone"></Entry>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Email" Style="{StaticResource Caption}" />
                                <Entry x:Name="t_customerEmail" Keyboard="Email"></Entry>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid x:Name="g_differentAddress">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="Customer address is different to the job address" VerticalOptions="Center" />
                            <CheckBox Grid.Column="1" x:Name="cb_differentAddress" VerticalOptions="Center" IsChecked="false"></CheckBox>
                        </Grid>

                        <Label x:Name="l_hide1" Text="House Name / Number" Style="{StaticResource Caption}" IsVisible="true"/>
                        <Entry x:Name="t_d_houseNumberName" IsVisible="true" IsEnabled="False"></Entry>

                        <Label x:Name="l_hide2" Text="Street" Style="{StaticResource Caption}" IsVisible="true"/>
                        <Entry x:Name="t_d_street" IsVisible="true" IsEnabled="False"></Entry>

                        <Label x:Name="l_hide3" Text="City / Town" Style="{StaticResource Caption}" IsVisible="true"/>
                        <Entry x:Name="t_d_city" IsVisible="true" IsEnabled="False"></Entry>

                        <Label x:Name="l_hide4" Text="Area" Style="{StaticResource Caption}" IsVisible="true"/>
                        <Entry x:Name="t_d_area" IsVisible="true" IsEnabled="False"></Entry>

                        <Label x:Name="l_hide5" Text="Postcode" Style="{StaticResource Caption}" IsVisible="true"/>
                        <Entry x:Name="t_d_postcode" IsVisible="true" IsEnabled="False"></Entry>
                    </VerticalStackLayout>
                </Border>

                <!--  MESSAGING  -->
                <Border x:Name="bd_messaging" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Messaging" Style="{StaticResource SectionTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="Text the night before" VerticalOptions="Center" />
                            <CheckBox Grid.Column="1" x:Name="cb_tnb" BackgroundColor="Transparent"></CheckBox>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="Text when the job is complete" VerticalOptions="Center" />
                            <CheckBox Grid.Column="1" x:Name="cb_tfc" BackgroundColor="Transparent"></CheckBox>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="Email the night before" VerticalOptions="Center" />
                            <CheckBox Grid.Column="1" x:Name="cb_enb" BackgroundColor="Transparent"></CheckBox>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="Email a receipt" VerticalOptions="Center" />
                            <CheckBox Grid.Column="1" x:Name="cb_eac" BackgroundColor="Transparent"></CheckBox>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </StackLayout>
</ContentPage>
