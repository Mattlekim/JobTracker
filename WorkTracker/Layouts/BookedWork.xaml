<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UiInterface.Layouts.BookedWork"
             Title="Booked In Work">

    <CollectionView x:Name="cv_bookings" IsGrouped="True">
        <CollectionView.EmptyView>
            <Label Text="No work booked in.&#10;&#10;Select jobs in the Work list and use 'Bookin Work' to plan a day."
                   Padding="20" HorizontalTextAlignment="Center" VerticalOptions="Center" FontSize="16"
                   TextColor="{StaticResource MidGray}"/>
        </CollectionView.EmptyView>

        <CollectionView.GroupHeaderTemplate>
            <DataTemplate>
                <Label Text="{Binding Header}" FontAttributes="Bold" FontSize="16" Padding="14,12,14,4"/>
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" Margin="8,3"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="job_Tapped" CommandParameter="{Binding .}"/>
                    </Border.GestureRecognizers>
                    <Grid Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding JobFormattedStreet}" FontAttributes="Bold"/>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Name}" TextColor="White" BackgroundColor="#EF6C00" Padding="6,2" FontAttributes="Bold" FontSize="12"/>
                                <Label Text="Done" TextColor="White" BackgroundColor="#4CAF50" Padding="6,2" FontAttributes="Bold" FontSize="12" IsVisible="{Binding IsCompleted}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding JobFormattedStringPrice}" FontAttributes="Bold" VerticalOptions="Center"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
