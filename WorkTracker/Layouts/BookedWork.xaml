<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UiInterface.Layouts.BookedWork"
             Title="Booked In Work">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- the day being moved and the date it is going to. stays hidden
             until a day's 'Change Date' is used -->
        <VerticalStackLayout x:Name="vsl_moveDay" Grid.Row="0" IsVisible="False" Padding="12,8" Spacing="6"
                             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <Label x:Name="l_moveDay" FontAttributes="Bold"/>
            <HorizontalStackLayout Spacing="8">
                <DatePicker x:Name="dp_moveTo" VerticalOptions="Center"/>
                <Button Text="Move" BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" Padding="8" Clicked="On_Move_Day_Confirm"/>
                <Button Text="Cancel" BackgroundColor="Transparent" TextColor="{StaticResource MidGray}" BorderColor="{StaticResource MidGray}" BorderWidth="2" Padding="8" Clicked="On_Move_Day_Cancel"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <CollectionView x:Name="cv_bookings" Grid.Row="1" IsGrouped="True">
        <CollectionView.EmptyView>
            <Label Text="No work booked in.&#10;&#10;Select jobs in the Work list and use 'Bookin Work' to plan a day."
                   Padding="20" HorizontalTextAlignment="Center" VerticalOptions="Center" FontSize="16"
                   TextColor="{StaticResource MidGray}"/>
        </CollectionView.EmptyView>

        <CollectionView.GroupHeaderTemplate>
            <DataTemplate>
                <!-- the whole day's work moves together, so the date belongs
                     on the day rather than on any one job -->
                <Grid Padding="14,12,14,4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Text="{Binding Header}" FontAttributes="Bold" FontSize="16" VerticalOptions="Center"/>
                    <Button Grid.Column="1" Text="Change Date" FontSize="12" Padding="8,0" HeightRequest="32" MinimumHeightRequest="32"
                            BackgroundColor="Transparent" TextColor="#FB8C00" BorderColor="#FB8C00" BorderWidth="2"
                            VerticalOptions="Center" Clicked="On_Change_Day_Date"/>
                </Grid>
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <!-- the actions open on a drag: on a round you are working one
                     handed with wet hands. Threshold is deliberately left unset -
                     on Android it clamps how far the row opens, so the actions
                     only peeked out instead of appearing -->
                <SwipeView>
                    <SwipeView.LeftItems>
                        <SwipeItems>
                            <SwipeItem Text="Done" IconImageSource="tick.png" CommandParameter="{Binding .}" BackgroundColor="#4CAF50" Invoked="On_Job_Compleated"/>
                            <SwipeItem Text="Done &amp; Paid" IconImageSource="donepaid.png" CommandParameter="{Binding .}" BackgroundColor="#2E7D32" Invoked="On_Job_Paid"/>
                            <SwipeItem Text="More" IconImageSource="more.png" CommandParameter="{Binding .}" BackgroundColor="#546E7A" Invoked="On_Job_More"/>
                        </SwipeItems>
                    </SwipeView.LeftItems>
                    <!-- unbooking and editing the job are held back for the
                         hold menu: they are not things to hit by accident -->
                    <SwipeView.RightItems>
                        <SwipeItems>
                            <SwipeItem Text="Skip" IconImageSource="skip.png" CommandParameter="{Binding .}" BackgroundColor="#FB8C00" Invoked="On_Job_Skipped"/>
                            <SwipeItem Text="Cancel" IconImageSource="cancel.png" CommandParameter="{Binding .}" BackgroundColor="#E53935" Invoked="On_Job_Canceled"/>
                        </SwipeItems>
                    </SwipeView.RightItems>

                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" Margin="8,3"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="job_Tapped" CommandParameter="{Binding .}"/>
                            <!-- holding a row brings up everything that can be
                                 done to it, the swipe actions included -->
                            <PointerGestureRecognizer PointerPressed="Job_PointerPressed"
                                                      PointerMoved="Job_PointerMoved"
                                                      PointerReleased="Job_PointerReleased"
                                                      PointerExited="Job_PointerReleased"/>
                        </Border.GestureRecognizers>
                        <!-- swipe gestures only work with touch, so desktop
                             (right click) gets the same actions as a menu -->
                        <FlyoutBase.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Done" CommandParameter="{Binding .}" Clicked="On_Job_Compleated"/>
                                <MenuFlyoutItem Text="Done &amp; Paid" CommandParameter="{Binding .}" Clicked="On_Job_Paid"/>
                                <MenuFlyoutItem Text="More" CommandParameter="{Binding .}" Clicked="On_Job_More"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Unbook" CommandParameter="{Binding .}" Clicked="On_Job_Unbook"/>
                                <MenuFlyoutItem Text="Skip" CommandParameter="{Binding .}" Clicked="On_Job_Skipped"/>
                                <MenuFlyoutItem Text="Cancel Job" CommandParameter="{Binding .}" Clicked="On_Job_Canceled"/>
                                <MenuFlyoutItem Text="Edit Details" CommandParameter="{Binding .}" Clicked="On_Job_Details"/>
                            </MenuFlyout>
                        </FlyoutBase.ContextFlyout>
                        <Grid Padding="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding JobFormattedStreet}" FontAttributes="Bold"/>
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Name}" TextColor="White" BackgroundColor="#EF6C00" Padding="6,2" FontAttributes="Bold" FontSize="12" IsVisible="{Binding HaveJobName}"/>
                                    <Label Text="Done" TextColor="White" BackgroundColor="#4CAF50" Padding="6,2" FontAttributes="Bold" FontSize="12" IsVisible="{Binding IsCompleted}"/>
                                    <!-- what the customer is behind or in credit by, only
                                         when there is something to settle -->
                                    <Label Text="{Binding JobFormattedOwed}" TextColor="White" BackgroundColor="{Binding OwedColorCode}" Padding="6,2" FontAttributes="Bold" FontSize="12" IsVisible="{Binding ShowOwed}" LineBreakMode="TailTruncation"/>
                                </HorizontalStackLayout>
                                <!-- notes get a line of their own so a long one cannot
                                     push the tags off the row -->
                                <Label Text="{Binding JobFormattedStringNotes}" TextColor="White" BackgroundColor="#FB8C00" Padding="6,2" FontSize="12" IsVisible="{Binding HaveJobNotes}" LineBreakMode="TailTruncation" MaxLines="1" HorizontalOptions="Start"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding JobFormattedStringPrice}" FontAttributes="Bold" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
