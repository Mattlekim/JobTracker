<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:UiInterface.Controles"
             x:Class="UiInterface.Layouts.BookedWork"
             Title="Booked In Work">

    <ContentPage.Resources>
        <!-- the same card Layouts/AllJobs and the work list draw a house on.
             it is the same round looked at another way, so a house should
             read the same way here too -->
        <Style x:Key="JobCard" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F2F4F7, Dark=#1E1E1E}" />
            <Setter Property="Margin" Value="12,0,12,6" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="JobCaption" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- the tags to put on work as it is marked done. folded away while
             nothing is set -->
        <controls:TagBar Grid.Row="0"></controls:TagBar>

        <!-- one button per booked day, so a week planned out can be looked
             at a day at a time instead of as one long list -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" x:Name="sv_dayPicker">
            <HorizontalStackLayout x:Name="hsl_dayPicker" Padding="8,6" Spacing="6"></HorizontalStackLayout>
        </ScrollView>

        <!-- the day being moved and the date it is going to. stays hidden
             until a day's 'Change Date' is used -->
        <VerticalStackLayout x:Name="vsl_moveDay" Grid.Row="2" IsVisible="False" Padding="12,8" Spacing="6"
                             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <Label x:Name="l_moveDay" FontAttributes="Bold"/>
            <HorizontalStackLayout Spacing="8">
                <DatePicker x:Name="dp_moveTo" VerticalOptions="Center"/>
                <Button Text="Move" BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" Padding="8" Clicked="On_Move_Day_Confirm"/>
                <Button Text="Cancel" BackgroundColor="Transparent" TextColor="{StaticResource MidGray}" BorderColor="{StaticResource MidGray}" BorderWidth="2" Padding="8" Clicked="On_Move_Day_Cancel"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- the classic pull down to build the days again from the jobs -->
        <RefreshView Grid.Row="3" x:Name="rv_bookings" Refreshing="rv_bookings_Refreshing">
        <CollectionView x:Name="cv_bookings" IsGrouped="True">
        <CollectionView.EmptyView>
            <Label Text="No work booked in.&#10;&#10;Select jobs in the Work list and use 'Bookin Work' to plan a day."
                   Padding="20" HorizontalTextAlignment="Center" VerticalOptions="Center" FontSize="16"
                   TextColor="{StaticResource MidGray}"/>
        </CollectionView.EmptyView>

        <CollectionView.GroupHeaderTemplate>
            <DataTemplate>
                <!-- the whole day's work moves together, so the date belongs
                     on the day rather than on any one job -->
                <Grid Padding="14,12,14,4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Header}" FontAttributes="Bold" FontSize="16" TextColor="{Binding HeaderColour}"/>
                        <Label Text="{Binding OverdueText}" FontAttributes="Bold" FontSize="12" TextColor="White" BackgroundColor="#C62828" Padding="6,2" IsVisible="{Binding IsOverdue}"/>
                        <!-- how far through the day you are, and what is left of it -->
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{Binding Progress}" FontAttributes="Bold" FontSize="12" TextColor="White" BackgroundColor="#455A64" Padding="6,2"/>
                            <Label Text="{Binding TimeLeft}" FontAttributes="Bold" FontSize="12" TextColor="White" BackgroundColor="#EF6C00" Padding="6,2" IsVisible="{Binding ShowTimeLeft}"/>
                        </HorizontalStackLayout>
                        <!-- the tags on this day's work, so a day tagged as a
                             whole says so on the day rather than only on each
                             house in it -->
                        <Label Text="{Binding TagsText}" FontAttributes="Bold" FontSize="12" TextColor="White" BackgroundColor="#00838F" Padding="6,2" IsVisible="{Binding HaveTags}" LineBreakMode="TailTruncation" MaxLines="1" HorizontalOptions="Start"/>
                    </VerticalStackLayout>
                    <!-- everything that can be done to the whole day, behind
                         one button: three of them across a phone leaves the
                         date itself nowhere to go -->
                    <Button Grid.Column="1" Text="Day ▾" FontSize="12" Padding="10,0" HeightRequest="32" MinimumHeightRequest="32"
                            BackgroundColor="Transparent" TextColor="#FB8C00" BorderColor="#FB8C00" BorderWidth="2"
                            VerticalOptions="Center" Clicked="On_Day_Options"
                            ToolTipProperties.Text="Tag this day's work, move it to another day, or cancel the booking"/>
                </Grid>
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <!-- the actions open on a drag: on a round you are working one
                     handed with wet hands. Threshold is deliberately left unset -
                     on Android it clamps how far the row opens, so the actions
                     only peeked out instead of appearing -->
                <!-- the swipe takes a held finger before anything else can see
                     it, so the hold is read back off the swipe itself -->
                <SwipeView SwipeStarted="swip_started" SwipeEnded="swip_ended">
                    <SwipeView.LeftItems>
                        <SwipeItems>
                            <SwipeItem Text="{Binding DoneActionText}" IconImageSource="tick.png" CommandParameter="{Binding .}" BackgroundColor="#4CAF50" Invoked="On_Job_Compleated"/>
                            <SwipeItem Text="Done &amp; Paid" IconImageSource="donepaid.png" CommandParameter="{Binding .}" BackgroundColor="#2E7D32" Invoked="On_Job_Paid" IsVisible="{Binding ShowPaidAction}"/>
                            <SwipeItem Text="More" IconImageSource="more.png" CommandParameter="{Binding .}" BackgroundColor="#546E7A" Invoked="On_Job_More"/>
                        </SwipeItems>
                    </SwipeView.LeftItems>
                    <!-- unbooking and editing the job are held back for the
                         hold menu: they are not things to hit by accident -->
                    <SwipeView.RightItems>
                        <SwipeItems>
                            <SwipeItem Text="Skip" IconImageSource="skip.png" CommandParameter="{Binding .}" BackgroundColor="#FB8C00" Invoked="On_Job_Skipped"/>
                            <SwipeItem Text="Cancel" IconImageSource="cancel.png" CommandParameter="{Binding .}" BackgroundColor="#E53935" Invoked="On_Job_Canceled"/>
                        </SwipeItems>
                    </SwipeView.RightItems>

                    <!-- one house, drawn the way Layouts/AllJobs draws it: a
                         card, the address in bold with the price beside it,
                         the town and area quiet underneath, what is owed said
                         in colour rather than sat on it, and the tags under
                         that. Same round, another page - it should not read
                         as a different app. -->
                    <Border Style="{StaticResource JobCard}">
                        <!-- holding a row brings up everything that can be
                             done to it, the swipe actions included. the
                             behaviour is what does it on a phone; the pointer
                             events are never raised for a finger and only do
                             the timing on a desktop -->
                        <Border.Behaviors>
                            <controls:LongPressBehavior/>
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="job_Tapped" CommandParameter="{Binding .}"/>
                            <PointerGestureRecognizer PointerPressed="Job_PointerPressed"
                                                      PointerMoved="Job_PointerMoved"
                                                      PointerReleased="Job_PointerReleased"
                                                      PointerExited="Job_PointerReleased"/>
                        </Border.GestureRecognizers>
                        <!-- swipe gestures only work with touch, so desktop
                             (right click) gets the same actions as a menu -->
                        <FlyoutBase.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="{Binding DoneActionText}" CommandParameter="{Binding .}" Clicked="On_Job_Compleated"/>
                                <MenuFlyoutItem Text="Done &amp; Paid" CommandParameter="{Binding .}" Clicked="On_Job_Paid" IsEnabled="{Binding ShowPaidAction}"/>
                                <MenuFlyoutItem Text="More" CommandParameter="{Binding .}" Clicked="On_Job_More"/>
                                <MenuFlyoutItem Text="Tag" CommandParameter="{Binding .}" Clicked="On_Job_Tag"/>
                                <MenuFlyoutItem Text="Do It Again" CommandParameter="{Binding .}" Clicked="On_Job_DoAgain" IsEnabled="{Binding CanDoAgain}"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Unbook" CommandParameter="{Binding .}" Clicked="On_Job_Unbook"/>
                                <MenuFlyoutItem Text="Skip" CommandParameter="{Binding .}" Clicked="On_Job_Skipped"/>
                                <MenuFlyoutItem Text="Cancel Job" CommandParameter="{Binding .}" Clicked="On_Job_Canceled"/>
                                <MenuFlyoutItem Text="Edit Details" CommandParameter="{Binding .}" Clicked="On_Job_Details"/>
                            </MenuFlyout>
                        </FlyoutBase.ContextFlyout>
                        <!-- fixed rows rather than a wrapping layout, so nothing
                             depends on a measure pass that could collapse inside
                             a virtualised list -->
                        <Grid ColumnSpacing="8" RowSpacing="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- the address, which is what somebody stood at a
                                 gate is actually reading. it truncates rather
                                 than pushing the price off the row -->
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding JobFormattedStreet}" FontAttributes="Bold" FontSize="15"
                                   LineBreakMode="TailTruncation" VerticalOptions="Center"/>

                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding JobFormattedStringPrice}" FontAttributes="Bold" FontSize="15"
                                   TextColor="#2E7D32" VerticalOptions="Center"/>

                            <!-- the town and the area, quiet under the street -->
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                                <Label Text="{Binding JobFormattedCity}" Style="{StaticResource JobCaption}" LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding JobFormattedArea}" Style="{StaticResource JobCaption}" LineBreakMode="TailTruncation"/>
                            </HorizontalStackLayout>

                            <!-- what is owed, said in colour rather than sat on
                                 it. the chip colours are made to be read white
                                 on colour and cannot be read as text on a card
                                 - see JobDisplay.OwedTextColour -->
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding JobFormattedOwed}" FontSize="12"
                                   TextColor="{Binding OwedTextColour}" IsVisible="{Binding ShowOwed}" LineBreakMode="TailTruncation"/>

                            <!-- the tags. the day is worked off this page, so
                                 what is on the job stays on show -->
                            <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4" Margin="0,4,0,0">
                                <Label Text="Done" TextColor="White" BackgroundColor="#4CAF50" Padding="6,2" FontAttributes="Bold" FontSize="12" IsVisible="{Binding IsCompleted}"/>
                                <Label Text="{Binding Name}" TextColor="White" BackgroundColor="#EF6C00" Padding="6,2" FontAttributes="Bold" FontSize="12" IsVisible="{Binding HaveJobName}" LineBreakMode="TailTruncation"/>
                                <Label Text="One off" TextColor="White" BackgroundColor="#546E7A" Padding="6,2" FontAttributes="Bold" FontSize="12" IsVisible="{Binding ShowOneOff}"/>
                                <!-- how long the job takes: what the day was
                                     planned off, on the day itself -->
                                <Label Text="{Binding LengthText}" TextColor="White" BackgroundColor="#5D4037" Padding="6,2" FontAttributes="Bold" FontSize="12" IsVisible="{Binding HaveLength}"/>
                            </HorizontalStackLayout>

                            <!-- what was different about this visit. its own line,
                                 because a day's worth of tags is longer than a row -->
                            <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding TagsText}" TextColor="White" BackgroundColor="#00838F" Padding="6,2" FontAttributes="Bold" FontSize="12" IsVisible="{Binding HaveTags}" LineBreakMode="TailTruncation" MaxLines="1" HorizontalOptions="Start" Margin="0,2,0,0"/>

                            <!-- notes get a line of their own so a long one cannot
                                 push the tags off the row -->
                            <Label Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding JobFormattedStringNotes}" TextColor="White" BackgroundColor="#FB8C00" Padding="6,2" FontSize="12" IsVisible="{Binding HaveJobNotes}" LineBreakMode="TailTruncation" MaxLines="1" HorizontalOptions="Start" Margin="0,2,0,0"/>
                        </Grid>
                    </Border>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
