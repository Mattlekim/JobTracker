<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UiInterface.Layouts.TaxView"
             Title="Tax">

    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F2F4F7, Dark=#1E1E1E}" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="Caption" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Export" Clicked="bnt_export_Clicked"></ToolbarItem>
        <ToolbarItem Text="Save This Tax Year" Clicked="bnt_saveYear_Clicked" Order="Secondary"></ToolbarItem>
        <ToolbarItem Text="Save Other Tax Years" Clicked="bnt_saveYears_Clicked" Order="Secondary"></ToolbarItem>
        <ToolbarItem Text="Bank Statements" Clicked="bnt_statements_Clicked" Order="Secondary"></ToolbarItem>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="12">

            <!--  WHAT IS BEING SHOWN  -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Tax year" Style="{StaticResource Caption}" />
                            <Picker x:Name="p_taxYear" SelectedIndexChanged="Selection_Changed"></Picker>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Income counted" Style="{StaticResource Caption}" />
                            <Picker x:Name="p_basis" SelectedIndexChanged="Selection_Changed">
                                <Picker.Items>
                                    <x:String>When paid (cash basis)</x:String>
                                    <x:String>When worked (accruals)</x:String>
                                </Picker.Items>
                            </Picker>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Text="Use calendar quarters (1 Apr - 30 Jun etc)" VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="sw_calendarQuarters" Toggled="Switch_Toggled"></Switch>
                    </Grid>
                    <Label Text="Only turn this on if you have elected calendar quarterly periods with HMRC." Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <!--  YEAR TOTALS  -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="l_yearTitle" FontAttributes="Bold" FontSize="16"></Label>
                    <Grid ColumnSpacing="8" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Text="Income" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                        <Label Grid.Row="0" Grid.Column="1" Text="Expenses" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                        <Label Grid.Row="0" Grid.Column="2" Text="Profit" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                        <Label Grid.Row="1" Grid.Column="0" x:Name="l_yearIncome" FontAttributes="Bold" TextColor="White" BackgroundColor="#2E7D32" Padding="6" HorizontalTextAlignment="Center" />
                        <Label Grid.Row="1" Grid.Column="1" x:Name="l_yearExpenses" FontAttributes="Bold" TextColor="White" BackgroundColor="#7B1FA2" Padding="6" HorizontalTextAlignment="Center" />
                        <Label Grid.Row="1" Grid.Column="2" x:Name="l_yearProfit" FontAttributes="Bold" TextColor="White" BackgroundColor="#00796B" Padding="6" HorizontalTextAlignment="Center" />
                    </Grid>
                    <Label x:Name="l_yearCounts" Style="{StaticResource Caption}"></Label>
                    <Label x:Name="l_receiptWarning" Style="{StaticResource Caption}" TextColor="#EF6C00" IsVisible="false"></Label>
                </VerticalStackLayout>
            </Border>

            <!--  QUARTERS  -->
            <Label Text="Quarterly updates" FontAttributes="Bold" FontSize="16" Margin="4,0,0,0" />
            <VerticalStackLayout x:Name="vsl_quarters" Spacing="8"></VerticalStackLayout>

            <!--  EXPENSES IN HMRC BOXES  -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Expenses by HMRC box (whole year)" FontAttributes="Bold" FontSize="16" />
                    <VerticalStackLayout x:Name="vsl_boxes" Spacing="4"></VerticalStackLayout>
                    <Label Text="Your expense categories are grouped into these boxes as a starting point. Check with your accountant before filing." Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <!--  WHAT THIS DOES AND DOES NOT DO  -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="About Making Tax Digital" FontAttributes="Bold" FontSize="16" />
                    <Label x:Name="l_mtdExplain" Style="{StaticResource Caption}"></Label>
                    <Button Text="Export For My Accountant" Clicked="bnt_export_Clicked" BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" CornerRadius="8" Padding="14,6" HorizontalOptions="Start"></Button>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
