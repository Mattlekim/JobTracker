<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:UiInterface.Controles"
             x:Class="UiInterface.Layouts.CalenderView"
             Title="Calendar">

    <ContentPage.Resources>

        <!-- a day's rows are street headings with the houses under them -
             the same street format All Jobs reads the round in, split by
             Controles/StreetSplit. A heading is a label and nothing else, so
             it cannot be swiped or tapped like work. The owed view is a list
             of people rather than a walk up a street, so it stays flat -->
        <DataTemplate x:Key="StreetRow">
            <Label Text="{Binding Street}" FontAttributes="Bold" FontSize="14" Margin="12,8,12,2"/>
        </DataTemplate>

        <DataTemplate x:Key="JobRow">
            <!-- a short drag opens the actions, so the list can be
                 worked one handed -->
            <SwipeView SwipeStarted="swip_started" SwipeEnded="swip_ended" IsEnabled="{Binding EnabledSwipe}">

                <SwipeView.LeftItems>
                    <SwipeItems>
                        <SwipeItem Text="Done"
                            IconImageSource="tick.png"
                            CommandParameter="{Binding Id}"
                            BackgroundColor="#4CAF50"
                            Invoked="On_Job_Compleated"
                                   />
                        <SwipeItem Text="Done &amp; Paid"
                            CommandParameter="{Binding Id}"
                            IconImageSource="donepaid.png"
                            BackgroundColor="#2E7D32"
                            Invoked="On_Job_Paid"
                                       />
                        <SwipeItem Text="More"
                            IconImageSource="more.png"
                            CommandParameter="{Binding Id}"
                            BackgroundColor="#546E7A"
                            Invoked="On_Job_More"
                                       />
                    </SwipeItems>
                </SwipeView.LeftItems>
                <SwipeView.RightItems>
                    <SwipeItems>
                        <SwipeItem Text="Skip"
                            IconImageSource="skip.png"
                            CommandParameter="{Binding Id}"
                            BackgroundColor="#FB8C00"
                            Invoked="On_Job_Skipped"
                                   />
                        <SwipeItem Text="Cancel"
                            IconImageSource="cancel.png"
                            CommandParameter="{Binding Id}"
                            BackgroundColor="#E53935"
                            Invoked="On_Job_Canceled"
                                       />
                        <SwipeItem Text="Edit Details"
                            IconImageSource="edit.png"
                            CommandParameter="{Binding Id}"
                            BackgroundColor="#1E88E5"
                            Invoked="On_Job_Detials"
                                       />
                        <SwipeItem Text="Expense"
                            IconImageSource="payments.png"
                            CommandParameter="{Binding Id}"
                            BackgroundColor="#7B1FA2"
                            Invoked="On_Job_Expense"
                                       />
                    </SwipeItems>
                </SwipeView.RightItems>

                <!-- one house, drawn by the shared card control
                     (Controles/JobCard) that every work list uses. The
                     street is the heading above the row, so the address is
                     the number alone. This is the one list that mixes
                     booked, unbooked and cancelled work, so those chips are
                     on; done work folds to the faded line that taps back
                     open, which the card handles itself -->
                <controls:JobCard Job="{Binding .}"
                                  AddressStyle="NumberOnly"
                                  ShowInfo="True"
                                  ShowBookedChip="True"
                                  ShowCancelledChip="True"
                                  CollapseCompleted="True"
                                  InfoClicked="Card_Info">
                    <!-- swipe gestures only work with touch, so desktop
                         (right click) gets the same actions as a menu -->
                    <FlyoutBase.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{Binding DoneActionText}" CommandParameter="{Binding Id}" Clicked="On_Job_Compleated" />
                            <MenuFlyoutItem Text="Done &amp; Paid" CommandParameter="{Binding Id}" Clicked="On_Job_Paid" IsEnabled="{Binding ShowPaidAction}" />
                            <MenuFlyoutItem Text="More" CommandParameter="{Binding Id}" Clicked="On_Job_More" />
                            <MenuFlyoutItem Text="Do It Again" CommandParameter="{Binding Id}" Clicked="On_Job_DoAgain" IsEnabled="{Binding CanDoAgain}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Skip" CommandParameter="{Binding Id}" Clicked="On_Job_Skipped" />
                            <MenuFlyoutItem Text="Cancel Job" CommandParameter="{Binding Id}" Clicked="On_Job_Canceled" />
                            <MenuFlyoutItem Text="Edit Details" CommandParameter="{Binding Id}" Clicked="On_Job_Detials" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Add Expense" CommandParameter="{Binding Id}" Clicked="On_Job_Expense" />
                        </MenuFlyout>
                    </FlyoutBase.ContextFlyout>
                </controls:JobCard>
            </SwipeView>
        </DataTemplate>

        <controls:StreetSplitTemplateSelector x:Key="CalendarRows"
                                              HeadingTemplate="{StaticResource StreetRow}"
                                              JobTemplate="{StaticResource JobRow}"/>

    </ContentPage.Resources>

    <!-- the tag bar is pinned above the list rather than riding along in its
         header: it is set while working through the day, and would be no use
         scrolled off the top of the page -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <!-- the tags to put on work as it is marked done. folded away while
             nothing is set -->
        <controls:TagBar Grid.Row="0"></controls:TagBar>

    <!-- The calendar, the day totals and the job list scroll as one page.
         They ride along as the list's header rather than sitting above it,
         because a ScrollView around the lot would put one scroll inside
         another and cost the list its virtualisation. -->
    <!-- the classic pull down to build the month again from the jobs -->
    <RefreshView Grid.Row="1" x:Name="rv_calendar" Refreshing="rv_calendar_Refreshing">
    <CollectionView x:Name="lv_Jobs" SelectionMode="None" RemainingItemsThreshold="0" ItemTemplate="{StaticResource CalendarRows}">
        <CollectionView.Header>
            <VerticalStackLayout>
                <HorizontalStackLayout HorizontalOptions="Center" x:Name="hsl_monthSelector">
                    <Button Text="&lt;" BorderColor="Orange" BackgroundColor="Transparent" TextColor="Orange" FontAttributes="Bold" VerticalOptions="Center" Clicked="bnt_previousMonthClicked"
                            BorderWidth="2" Padding="0" WidthRequest="44" HeightRequest="38"></Button>
                    <Label x:Name="l_date" Text="May 2022" HorizontalOptions="Center" FontSize="Default" FontAttributes="Bold" VerticalOptions="Center" Padding="8"></Label>
                    <Button Text="&gt;" BorderColor="Orange" BackgroundColor="Transparent" TextColor="Orange" FontAttributes="Bold" VerticalOptions="Center" Clicked="bnt_nextMonthClicked"
                             BorderWidth="2" Padding="0" WidthRequest="44" HeightRequest="38"></Button>
                </HorizontalStackLayout>
                <!--                         THIS IS THE CALENDER GRID      ALL LABLES ARE ADDED IN THE CS FILE             -->
                <Grid x:Name="g_calender">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                </Grid>
                <VerticalStackLayout HorizontalOptions="Center" Margin="0,0,0,12">
                    <Label x:Name="l_currentDayName" FontSize="Default" FontAttributes="Bold" HorizontalOptions="Center" Padding="8,8,8,4"></Label>
                    <HorizontalStackLayout HorizontalOptions="Center">
                        <!-- what the day's work comes to and how much of it
                             has actually been done. Not the same question as
                             what has been paid: the money for a clean comes
                             in weeks after it -->
                        <Label x:Name="l_dayJobTotal" FontAttributes="Bold" TextColor="White" BackgroundColor="#2E7D32" Padding="6"></Label>
                        <!-- tapping what has come in asks the other question:
                             who has not paid -->
                        <Label x:Name="l_dayPaymentTotal" FontAttributes="Bold" TextColor="White" BackgroundColor="#00796B" Padding="6" Margin="8,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="l_dayPaymentTotal_Tapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label x:Name="l_dayExpenseTotal" FontAttributes="Bold" TextColor="White" BackgroundColor="#7B1FA2" Padding="6" Margin="8,0,0,0" IsVisible="false"></Label>
                    </HorizontalStackLayout>
                    <!-- shown in place of a day's work while the list is filtered -->
                    <HorizontalStackLayout x:Name="hsl_filter" HorizontalOptions="Center" Spacing="8" Margin="0,6,0,0" IsVisible="false">
                        <Label x:Name="l_filter" FontAttributes="Bold" TextColor="White" BackgroundColor="#C62828" Padding="6" VerticalOptions="Center"></Label>
                        <Button Text="Show The Day" Clicked="bnt_clearFilter_Clicked" FontSize="12" Padding="12,2"
                                BackgroundColor="Transparent" BorderWidth="2" BorderColor="#C62828" TextColor="#C62828" CornerRadius="8"></Button>
                    </HorizontalStackLayout>

                    <!-- how the day is going, and how much of it is left -->
                    <HorizontalStackLayout HorizontalOptions="Center" Margin="0,6,0,0">
                        <Label x:Name="l_dayProgress" FontAttributes="Bold" TextColor="White" BackgroundColor="#455A64" Padding="6" IsVisible="false"></Label>
                        <Label x:Name="l_dayTimeLeft" FontAttributes="Bold" TextColor="White" BackgroundColor="#EF6C00" Padding="6" Margin="8,0,0,0" IsVisible="false"></Label>
                    </HorizontalStackLayout>

                    <!-- work due on a day still to come can be booked in for
                         it right here, so it is one tap on the day and one on
                         the button -->
                    <Button x:Name="bnt_bookDayIn" Text="Book All In" Clicked="bnt_bookDayIn_Clicked" IsVisible="false"
                            FontSize="12" Padding="14,4" Margin="0,8,0,0" HorizontalOptions="Center"
                            BackgroundColor="Transparent" BorderWidth="2" BorderColor="#EF6C00" TextColor="#EF6C00" CornerRadius="8"></Button>
                </VerticalStackLayout>
                <!--                       THIS IS THE LIST OF JOBS TO DISPLAY!!!!                       -->
                <Label x:Name="l_noJobs" FontSize="Title" HorizontalOptions="Center" Text="No Jobs To Do" Padding="16"></Label>
            </VerticalStackLayout>
        </CollectionView.Header>
    </CollectionView>
    </RefreshView>
    </Grid>
</ContentPage>
