<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:UiInterface.Controles"
             x:Class="UiInterface.Layouts.CalenderView"
             Title="Calendar">

    <ContentPage.Resources>
        <!-- the same card Layouts/AllJobs and the work list draw a house on.
             it is the same round looked at another way, so a house should
             read the same way here too. the card gap is what tells one house
             from the next now, which is why the rows no longer stripe with
             AltColour -->
        <Style x:Key="JobCard" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F2F4F7, Dark=#1E1E1E}" />
            <Setter Property="Margin" Value="12,0,12,6" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="JobCaption" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
        </Style>
    </ContentPage.Resources>

    <!-- the tag bar is pinned above the list rather than riding along in its
         header: it is set while working through the day, and would be no use
         scrolled off the top of the page -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <!-- the tags to put on work as it is marked done. folded away while
             nothing is set -->
        <controls:TagBar Grid.Row="0"></controls:TagBar>

    <!-- The calendar, the day totals and the job list scroll as one page.
         They ride along as the list's header rather than sitting above it,
         because a ScrollView around the lot would put one scroll inside
         another and cost the list its virtualisation. -->
    <!-- the classic pull down to build the month again from the jobs -->
    <RefreshView Grid.Row="1" x:Name="rv_calendar" Refreshing="rv_calendar_Refreshing">
    <CollectionView x:Name="lv_Jobs" SelectionMode="None" RemainingItemsThreshold="0">
        <CollectionView.Header>
            <VerticalStackLayout>
                <HorizontalStackLayout HorizontalOptions="Center" x:Name="hsl_monthSelector">
                    <Button Text="&lt;" BorderColor="Orange" BackgroundColor="Transparent" TextColor="Orange" FontAttributes="Bold" VerticalOptions="Center" Clicked="bnt_previousMonthClicked"
                            BorderWidth="2" Padding="0" WidthRequest="44" HeightRequest="38"></Button>
                    <Label x:Name="l_date" Text="May 2022" HorizontalOptions="Center" FontSize="Default" FontAttributes="Bold" VerticalOptions="Center" Padding="8"></Label>
                    <Button Text="&gt;" BorderColor="Orange" BackgroundColor="Transparent" TextColor="Orange" FontAttributes="Bold" VerticalOptions="Center" Clicked="bnt_nextMonthClicked"
                             BorderWidth="2" Padding="0" WidthRequest="44" HeightRequest="38"></Button>
                </HorizontalStackLayout>
                <!--                         THIS IS THE CALENDER GRID      ALL LABLES ARE ADDED IN THE CS FILE             -->
                <Grid x:Name="g_calender">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                </Grid>
                <VerticalStackLayout HorizontalOptions="Center" Margin="0,0,0,12">
                    <Label x:Name="l_currentDayName" FontSize="Default" FontAttributes="Bold" HorizontalOptions="Center" Padding="8,8,8,4"></Label>
                    <HorizontalStackLayout HorizontalOptions="Center">
                        <Label x:Name="l_dayJobTotal" FontAttributes="Bold" TextColor="White" BackgroundColor="#2E7D32" Padding="6"></Label>
                        <!-- tapping what has come in asks the other question:
                             who has not paid -->
                        <Label x:Name="l_dayPaymentTotal" FontAttributes="Bold" TextColor="White" BackgroundColor="#00796B" Padding="6" Margin="8,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="l_dayPaymentTotal_Tapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label x:Name="l_dayExpenseTotal" FontAttributes="Bold" TextColor="White" BackgroundColor="#7B1FA2" Padding="6" Margin="8,0,0,0" IsVisible="false"></Label>
                    </HorizontalStackLayout>
                    <!-- shown in place of a day's work while the list is filtered -->
                    <HorizontalStackLayout x:Name="hsl_filter" HorizontalOptions="Center" Spacing="8" Margin="0,6,0,0" IsVisible="false">
                        <Label x:Name="l_filter" FontAttributes="Bold" TextColor="White" BackgroundColor="#C62828" Padding="6" VerticalOptions="Center"></Label>
                        <Button Text="Show The Day" Clicked="bnt_clearFilter_Clicked" FontSize="12" Padding="12,2"
                                BackgroundColor="Transparent" BorderWidth="2" BorderColor="#C62828" TextColor="#C62828" CornerRadius="8"></Button>
                    </HorizontalStackLayout>

                    <!-- how the day is going, and how much of it is left -->
                    <HorizontalStackLayout HorizontalOptions="Center" Margin="0,6,0,0">
                        <Label x:Name="l_dayProgress" FontAttributes="Bold" TextColor="White" BackgroundColor="#455A64" Padding="6" IsVisible="false"></Label>
                        <Label x:Name="l_dayTimeLeft" FontAttributes="Bold" TextColor="White" BackgroundColor="#EF6C00" Padding="6" Margin="8,0,0,0" IsVisible="false"></Label>
                    </HorizontalStackLayout>

                    <!-- work due on a day still to come can be booked in for
                         it right here, so it is one tap on the day and one on
                         the button -->
                    <Button x:Name="bnt_bookDayIn" Text="Book All In" Clicked="bnt_bookDayIn_Clicked" IsVisible="false"
                            FontSize="12" Padding="14,4" Margin="0,8,0,0" HorizontalOptions="Center"
                            BackgroundColor="Transparent" BorderWidth="2" BorderColor="#EF6C00" TextColor="#EF6C00" CornerRadius="8"></Button>
                </VerticalStackLayout>
                <!--                       THIS IS THE LIST OF JOBS TO DISPLAY!!!!                       -->
                <Label x:Name="l_noJobs" FontSize="Title" HorizontalOptions="Center" Text="No Jobs To Do" Padding="16"></Label>
            </VerticalStackLayout>
        </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate >

                    <!-- a short drag opens the actions, so the list can be
                         worked one handed -->
                    <SwipeView x:Name="sv" SwipeStarted="swip_started" SwipeEnded="swip_ended" IsEnabled="{Binding EnabledSwipe}">

                        <SwipeView.LeftItems  >
                            <SwipeItems >
                                <SwipeItem Text="Done" 
                                    IconImageSource="tick.png"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="#4CAF50"
                                    Invoked="On_Job_Compleated"
                                           />
                                <SwipeItem Text="Done &amp; Paid"
                                    CommandParameter="{Binding Id}"
                                    IconImageSource="donepaid.png"
                                    BackgroundColor="#2E7D32"
                                    Invoked="On_Job_Paid" 
                                               />
                                <SwipeItem Text="More"
                                    IconImageSource="more.png"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="#546E7A"
                                    Invoked="On_Job_More" 
                                                   
                                               />
                            </SwipeItems>
                        </SwipeView.LeftItems>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Skip" 
                                    IconImageSource="skip.png"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="#FB8C00"
                                    Invoked="On_Job_Skipped"
                                           />
                                <SwipeItem Text="Cancel"
                                    IconImageSource="cancel.png"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="#E53935"
                                    Invoked="On_Job_Canceled" 
                                               />
                                <SwipeItem Text="Edit Details"
                                    IconImageSource="edit.png"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="#1E88E5"
                                    Invoked="On_Job_Detials"
                                               />
                                <SwipeItem Text="Expense"
                                    IconImageSource="payments.png"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="#7B1FA2"
                                    Invoked="On_Job_Expense"
                                               />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <!-- one house, drawn the way Layouts/AllJobs draws it: a
                             card, the address in bold with the price beside it,
                             the town and area quiet underneath, when it is due
                             and what is owed said in colour rather than sat on
                             it, and the tags under that. Same round, another
                             page - it should not read as a different app. -->
                        <Border Style="{StaticResource JobCard}">
                        <VerticalStackLayout>
                            <!-- swipe gestures only work with touch, so desktop
                                 (right click) gets the same actions as a menu -->
                            <FlyoutBase.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="{Binding DoneActionText}" CommandParameter="{Binding Id}" Clicked="On_Job_Compleated" />
                                    <MenuFlyoutItem Text="Done &amp; Paid" CommandParameter="{Binding Id}" Clicked="On_Job_Paid" IsEnabled="{Binding ShowPaidAction}" />
                                    <MenuFlyoutItem Text="More" CommandParameter="{Binding Id}" Clicked="On_Job_More" />
                                    <MenuFlyoutItem Text="Do It Again" CommandParameter="{Binding Id}" Clicked="On_Job_DoAgain" IsEnabled="{Binding CanDoAgain}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Skip" CommandParameter="{Binding Id}" Clicked="On_Job_Skipped" />
                                    <MenuFlyoutItem Text="Cancel Job" CommandParameter="{Binding Id}" Clicked="On_Job_Canceled" />
                                    <MenuFlyoutItem Text="Edit Details" CommandParameter="{Binding Id}" Clicked="On_Job_Detials" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Add Expense" CommandParameter="{Binding Id}" Clicked="On_Job_Expense" />
                                </MenuFlyout>
                            </FlyoutBase.ContextFlyout>
                            <!-- completed jobs show as this narrow faded row; tap to expand -->
                            <HorizontalStackLayout IsVisible="{Binding CollapsedInList}" Opacity="0.4" Spacing="6">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="CollapsedJob_Tapped"></TapGestureRecognizer>
                                </HorizontalStackLayout.GestureRecognizers>
                                <Label Text="{Binding JobFormattedHouseNumber}" FontAttributes="Bold" />
                                <Label Text="{Binding JobFormattedStreetOnly}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding JobFormattedCity}" LineBreakMode="TailTruncation" />
                            </HorizontalStackLayout>
                            <!-- fixed rows rather than a wrapping layout, so
                                 nothing depends on a measure pass that could
                                 collapse inside a virtualised list -->
                            <Grid IsVisible="{Binding ExpandedInList}" ColumnSpacing="8" RowSpacing="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <!-- the address, which is what somebody stood at
                                     a gate is actually reading. the street takes
                                     whatever width is left and truncates rather
                                     than pushing the price off the row -->
                                <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding JobFormattedHouseNumber}" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
                                    <Label Text="{Binding JobFormattedStreetOnly}" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                </HorizontalStackLayout>

                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding JobFormattedStringPrice}" FontAttributes="Bold" FontSize="15" TextColor="#2E7D32" VerticalOptions="Center"></Label>

                                <!-- an icon with no words to it, so it carries a
                                     tooltip. Same size as the one on the work
                                     list - it is the same button and it should
                                     not move or change size between pages -->
                                <ImageButton Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" Source="info.png" HeightRequest="34" WidthRequest="34" Padding="5" CornerRadius="17" BackgroundColor="#1E88E5" HorizontalOptions="Center" VerticalOptions="Center" Clicked="bnt_info_Clicked"  ClassId="{Binding Id}"
                                             ToolTipProperties.Text="Everything about this job - price, notes, when it is due and who it is for"></ImageButton>

                                <!-- the town and the area, quiet under the street -->
                                <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                                    <Label Text="{Binding JobFormattedCity}" Style="{StaticResource JobCaption}" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding JobFormattedArea}" Style="{StaticResource JobCaption}" LineBreakMode="TailTruncation" />
                                </HorizontalStackLayout>

                                <!-- when it is due and what is owed, said in colour
                                     rather than sat on it. the chip colours are made
                                     to be read white on colour and cannot be read as
                                     text on a card - see JobDisplay.DueTextColour -->
                                <Label Grid.Row="2" Grid.Column="0" Text="{Binding JobFormattedDueTime}" FontSize="12" TextColor="{Binding DueTextColour}" VerticalOptions="Center"></Label>

                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding JobFormattedOwed}" FontSize="12" TextColor="{Binding OwedTextColour}" IsVisible="{Binding ShowOwed}" VerticalOptions="Center" LineBreakMode="TailTruncation"></Label>

                                <!-- the tags: what the work is, whether it is booked
                                     in, how long it takes and anything owing about it -->
                                <HorizontalStackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4" Margin="0,4,0,0">
                                    <Label Text="Bookin" TextColor="White" BackgroundColor="OrangeRed" IsVisible="{Binding IsBookedIn}" Padding="6,2" FontSize="12" FontAttributes="Bold"></Label>
                                    <Label Text="{Binding Name}" FontAttributes="Bold" Padding="6,2" BackgroundColor="#EF6C00" TextColor="White" FontSize="12" IsVisible="{Binding HaveJobName}" LineBreakMode="TailTruncation"></Label>
                                    <Label Text="Canceled" TextColor="White" BackgroundColor="Red" IsVisible="{Binding HaveCanceled}" Padding="6,2" FontSize="12" FontAttributes="Bold"></Label>
                                    <Label Text="One off" TextColor="White" BackgroundColor="#546E7A" IsVisible="{Binding ShowOneOff}" Padding="6,2" FontSize="12" FontAttributes="Bold"></Label>
                                    <!-- how long the job takes, which is what the
                                         day's own total is made of -->
                                    <Label Text="{Binding LengthText}" TextColor="White" BackgroundColor="#5D4037" IsVisible="{Binding HaveLength}" Padding="6,2" FontSize="12" FontAttributes="Bold"></Label>
                                    <Label Text="TNB" TextColor="White" BackgroundColor="#C62828" IsVisible="{Binding TNB}" Padding="6,2" FontSize="12" FontAttributes="Bold"></Label>
                                    <Label Text="ENB" TextColor="White" BackgroundColor="#C62828" IsVisible="{Binding ENB}" Padding="6,2" FontSize="12" FontAttributes="Bold"></Label>
                                    <!-- direct debit requested, waiting for the money to come through -->
                                    <Label Text="{Binding PaymentPendingText}" TextColor="White" BackgroundColor="#6A1B9A" IsVisible="{Binding PaymentPending}" Padding="6,2" FontSize="12" FontAttributes="Bold"></Label>
                                </HorizontalStackLayout>

                                <!-- what was different about this visit. its own line,
                                     because a day's worth of tags is longer than a row -->
                                <Label Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding TagsText}" TextColor="White" BackgroundColor="#00838F" IsVisible="{Binding HaveTags}" Padding="6,2" FontSize="12" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="1" HorizontalOptions="Start" Margin="0,2,0,0"></Label>

                                <!-- notes get their own line under the tags -->
                                <Label Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" BackgroundColor="#FB8C00" Text="{Binding JobFormattedStringNotes}" TextColor="White" Padding="6,2" FontSize="12" IsVisible="{Binding HaveJobNotes}" LineBreakMode="TailTruncation" MaxLines="1" HorizontalOptions="Start" Margin="0,2,0,0"></Label>
                            </Grid>
                        </VerticalStackLayout>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
    </CollectionView>
    </RefreshView>
    </Grid>
</ContentPage>
