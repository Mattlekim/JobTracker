<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:UiInterface.Layouts"
             xmlns:controls="clr-namespace:UiInterface.Controles"
             x:Class="UiInterface.Layouts.AllJobs"
             Title="All Jobs">

    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F2F4F7, Dark=#1E1E1E}" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="Caption" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
        </Style>

        <!--  the round, then the area, the town and the street under it  -->
        <Style x:Key="RoundHeading" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#00695C, Dark=#4DB6AC}" />
            <Setter Property="Margin" Value="12,18,12,2" />
        </Style>
        <Style x:Key="PlaceHeading" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
            <Setter Property="Margin" Value="12,8,12,0" />
        </Style>
        <Style x:Key="StreetHeading" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="12,8,12,2" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!--  how much round there is, before any of it is scrolled through  -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="12,12,12,0">
            <VerticalStackLayout Spacing="4">
                <Label x:Name="l_total" FontAttributes="Bold" FontSize="16"></Label>
                <Label x:Name="l_note" Style="{StaticResource Caption}"></Label>
            </VerticalStackLayout>
        </Border>

        <!--  what the list has been cut down to, with the way back out beside
              it. A filter must never be on with nothing on screen saying so  -->
        <Grid Grid.Row="1" x:Name="g_filter" IsVisible="false" BackgroundColor="#00695C"
              Padding="12,6" ColumnSpacing="8" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" x:Name="l_filter" FontSize="13" TextColor="White" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Show All" Clicked="bnt_clearFilter_Clicked" FontSize="12" Padding="12,4"
                    BackgroundColor="Transparent" BorderWidth="2" BorderColor="White" TextColor="White" CornerRadius="8" />
        </Grid>

        <Label Grid.Row="2" x:Name="l_empty" IsVisible="false" Margin="16,16" Style="{StaticResource Caption}"
               Text="No work on the round yet. Add Job on the work list or the job list puts the first house on."></Label>

        <!-- the classic pull down to build the page again from the jobs -->
        <RefreshView Grid.Row="2" x:Name="rv_jobs" Refreshing="rv_jobs_Refreshing">
        <CollectionView x:Name="cv_jobs" SelectionMode="Single" SelectionChanged="cv_jobs_SelectionChanged">
            <CollectionView.ItemTemplate>
                <!--  x:DataType compiles the bindings, so a row that is renamed
                      is a build error rather than a blank label nobody notices  -->
                <DataTemplate x:DataType="local:AllJobsRow">

                    <!--  one template for the lot: a row is either a heading or
                          a house, and the headings only differ by which of the
                          three they are  -->
                    <VerticalStackLayout>

                        <Label Text="{Binding Heading}" IsVisible="{Binding IsRoundHeading}" Style="{StaticResource RoundHeading}" />
                        <Label Text="{Binding Heading}" IsVisible="{Binding IsPlaceHeading}" Style="{StaticResource PlaceHeading}" />
                        <Label Text="{Binding Heading}" IsVisible="{Binding IsStreetHeading}" Style="{StaticResource StreetHeading}" />

                        <!--  the same card control every work list draws a
                              house with (Controles/JobCard). The street is
                              the heading above the row, so the address is the
                              number alone; the due date is written out with
                              how far past it is, because this page is read
                              over rather than worked off; and the money is
                              always answered - owes, in credit or nothing
                              owed. How often the house comes round is the
                              page's own line, because the round is read off
                              the whole job through the page's grouping.  -->
                        <controls:JobCard IsVisible="{Binding IsJob}"
                                          Job="{Binding Job}"
                                          ExtraCaption="{Binding HowOftenAndRound}"
                                          AddressStyle="NumberOnly"
                                          DueStyle="LongDate"
                                          OwedStyle="Always"
                                          PriceStyle="Effective"
                                          ShowPlace="False"
                                          ShowChips="False"
                                          ShowTags="False"
                                          ShowNotes="False" />

                    </VerticalStackLayout>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
