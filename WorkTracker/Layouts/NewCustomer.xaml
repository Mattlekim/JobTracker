<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UiInterface.Layouts.NewCustomer"
             Title="NewCustomer"
             >
    <ScrollView>
        <VerticalStackLayout>

            <!-- the address is not offered by the contacts api, so only the
                 name, number and email come across -->
            <Button x:Name="_bnt_fromContacts" Text="Fill From Contacts" Clicked="bnt_FromContacts"
                    BackgroundColor="Transparent" BorderColor="Orange" TextColor="Orange" BorderWidth="2"
                    HorizontalOptions="Start" Margin="0,8,0,8"></Button>

            <Label Text="Name"/>
            <Entry x:Name="t_fName"></Entry>

            <Label Text="Phone Number"/>
            <Entry x:Name="t_phone"></Entry>

            <Label Text="Email"/>
            <Entry x:Name="t_email"></Entry>

            <Label Text="Starting Balance"/>
            <Entry x:Name="t_balance"></Entry>

            <Label Text="Date Aquired"/>
            <DatePicker x:Name="t_date"></DatePicker>

            <Picker x:Name="t_preferedPayment" Title="Prefered Payment">
                <Picker.Items>
                    <x:String>Cash</x:String>
                    <x:String>Card</x:String>
                    <x:String>Paypal</x:String>
                    <x:String>Bank</x:String>
                    <x:String>Check</x:String>
                    <x:String>GoCardless</x:String>
                    <x:String>Other</x:String>
                </Picker.Items>
            </Picker>


            <Label Text=""/>
            <!-- the icon fills the street, town, area and postcode in from
                 where the phone is standing. the house number is left alone
                 on purpose -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Text="Address" VerticalOptions="Center"/>
                <ImageButton Grid.Column="1" x:Name="bnt_useLocation" Source="location.png" Clicked="bnt_useLocation_Clicked"
                             HeightRequest="38" WidthRequest="38" Padding="8" CornerRadius="19" BackgroundColor="#1E88E5" VerticalOptions="Center"></ImageButton>
            </Grid>

            <Label Text="House Name / Number"/>
            <Entry x:Name="t_houseNumberName"></Entry>

            <Label Text="Street"/>
            <Entry x:Name="t_street"></Entry>
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="hsl_streetSuggestions" Spacing="6" Padding="0,2" IsVisible="false"></HorizontalStackLayout>
            </ScrollView>

            <Label Text="City / Town"/>
            <Entry x:Name="t_city"></Entry>
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="hsl_citySuggestions" Spacing="6" Padding="0,2" IsVisible="false"></HorizontalStackLayout>
            </ScrollView>

            <Label Text="Area"/>
            <Entry x:Name="t_area"></Entry>
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="hsl_areaSuggestions" Spacing="6" Padding="0,2" IsVisible="false"></HorizontalStackLayout>
            </ScrollView>

            <Label Text="Postcode"/>
            <Entry x:Name="t_postcode"></Entry>


            <HorizontalStackLayout>
            <Button x:Name="_bnt_cancel" Text="Cancel" Clicked="bnt_Cancel" WidthRequest="200" HorizontalOptions="EndAndExpand"></Button>
            <Button x:Name="_bnt_Add" Text="Add" Clicked="bnt_Add" WidthRequest="200" HorizontalOptions="End"></Button>
            <Button x:Name="_bnt_Delete" Text="Delete" Clicked="bnt_Delete" WidthRequest="200" HorizontalOptions="End" BackgroundColor="Red"></Button>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
