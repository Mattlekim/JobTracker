<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:UiInterface.Controles"
             x:Class="UiInterface.Layouts.WorkPlanner"
             Title="WorkPlanner">
    <!-- the toolbar items keep their Text as well as the icon: it is what
         Android shows on a long press and what the ... menu reads, so an
         icon never leaves somebody guessing -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Search" IconImageSource="search.png" Clicked="tbi_Search_Clicked"></ToolbarItem>
    </ContentPage.ToolbarItems>


    <Grid x:Name="g_root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <!-- side panel column, opened by code when the window is wide enough -->
            <ColumnDefinition x:Name="cd_sidePanel" Width="0"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <VerticalStackLayout x:Name="vsl_header" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">

            <!-- the tags to put on work as it is marked done. folded away
                 while nothing is set -->
            <controls:TagBar></controls:TagBar>

            <!-- while jobs are being picked out. the toolbar has a Cancel on
                 it too, but on a phone that is as likely as not to be behind
                 the ... menu, and a mode you did not mean to be in needs a
                 way out that is actually on the screen -->
            <Border x:Name="brd_selecting" IsVisible="false" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                    BackgroundColor="#00695C" Margin="8,6,8,0" Padding="12,8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" x:Name="l_selectedCount" TextColor="White" FontAttributes="Bold" VerticalOptions="Center"></Label>
                    <Button Grid.Column="1" Text="Book In" Clicked="bnt_BookinWork_Clicked" FontSize="12" Padding="14,4" CornerRadius="8"
                            BackgroundColor="Transparent" BorderWidth="2" BorderColor="White" TextColor="White" VerticalOptions="Center"
                            ToolTipProperties.Text="Put the jobs you have picked in for a day"></Button>
                    <Button Grid.Column="2" Text="Cancel" Clicked="Bnt_cancelSelection_Clicked" FontSize="12" Padding="14,4" CornerRadius="8"
                            BackgroundColor="Transparent" BorderWidth="2" BorderColor="White" TextColor="White" VerticalOptions="Center"
                            ToolTipProperties.Text="Stop picking jobs and put the tick boxes away"></Button>
                </Grid>
            </Border>

            <!-- filters as it is typed into, so a house can be found without
                 scrolling the whole round -->
            <Grid Padding="8,6" ColumnSpacing="6" x:Name="g_search" IsVisible="false">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Entry Grid.Column="0" x:Name="e_search" Placeholder="Search address, name or phone" TextChanged="e_search_Changed"/>
                <Button Grid.Column="1" Text="Clear" Clicked="bnt_clearSearch_Clicked" FontSize="12" Padding="12,4"
                        BackgroundColor="Transparent" BorderWidth="2" BorderColor="#6B7280" TextColor="#6B7280" CornerRadius="8"
                        ToolTipProperties.Text="Empty the search box and put the whole list back"/>
            </Grid>

            <!-- What the list is being narrowed by, on show whether the panel
                 below is open or not. A list quietly showing a third of the
                 round with nothing to say why is how these came to be turned
                 off in the first place. -->
            <Border x:Name="brd_filterOn" IsVisible="false" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                    BackgroundColor="#2E7D32" Margin="8,6,8,0" Padding="12,8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                        <Label x:Name="l_filterResultsText" TextColor="White" FontAttributes="Bold" FontSize="14"></Label>
                        <Label x:Name="l_filterResultsCount" TextColor="#C8E6C9" FontSize="12"></Label>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Clear" Clicked="bnt_ClearTagFilter_Clicked" FontSize="12" Padding="14,4"
                            BackgroundColor="Transparent" BorderWidth="2" BorderColor="White" TextColor="White" CornerRadius="8"
                            VerticalOptions="Center"></Button>
                </Grid>
            </Border>

            <!-- the filter panel, opened from the Filters toolbar item -->
            <Border x:Name="g_filter" IsVisible="false" StrokeThickness="0" StrokeShape="RoundRectangle 12" Margin="8,6" Padding="14"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <VerticalStackLayout Spacing="14">

                    <Label Text="Filters" FontAttributes="Bold" FontSize="16"></Label>

                    <!--  WHAT THE LIST IS KEPT TO  -->
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="6">
                            <CheckBox x:Name="cb_filterDates" IsChecked="true" CheckedChanged="cb_UpdateMasterFilter" VerticalOptions="Center"></CheckBox>
                            <Label Text="Only the work in hand" FontAttributes="Bold" VerticalOptions="Center"></Label>
                        </HorizontalStackLayout>
                        <Label Text="Work due up to the second date, and anything finished since the first. Turn it off to see the whole round. Work already booked in has its own page and is not on this list either way."
                               FontSize="12" TextColor="{StaticResource MidGray}"></Label>
                        <Grid x:Name="g_dateRange" ColumnSpacing="6" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="From" VerticalOptions="Center" FontSize="12"></Label>
                            <DatePicker Grid.Column="1" x:Name="dp_StartSearchDate" DateSelected="UpdateMasterFileterStart" FontSize="13"></DatePicker>
                            <Label Grid.Column="2" Text="To" VerticalOptions="Center" FontSize="12"></Label>
                            <DatePicker Grid.Column="3" x:Name="dp_EndSearchDate" DateSelected="UpdateMasterFileterEnd" FontSize="13"></DatePicker>
                        </Grid>
                    </VerticalStackLayout>

                    <!--  THE TAG FILTER  -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Narrow it down" FontAttributes="Bold"></Label>
                        <Label Text="Tap any tag on a job - what it is, the price, the street, the town or what is owed - and the list drops to the work that matches it, right across the round."
                               FontSize="12" TextColor="{StaticResource MidGray}"></Label>
                        <HorizontalStackLayout x:Name="hsl_tagFilter" Spacing="8" IsVisible="false">
                            <Label x:Name="l_filterBy" TextColor="White" BackgroundColor="#00838F" Padding="8,3" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"></Label>
                            <Button Text="Clear" Clicked="bnt_ClearTagFilter_Clicked" FontSize="12" Padding="12,2" CornerRadius="8"
                                    BackgroundColor="Transparent" BorderWidth="2" BorderColor="#E53935" TextColor="#E53935" VerticalOptions="Center"></Button>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!--  CANCELLED WORK  -->
                    <HorizontalStackLayout Spacing="6">
                        <CheckBox x:Name="cb_showCancelled" IsChecked="false" CheckedChanged="cb_showCancelled_Changed" VerticalOptions="Center"></CheckBox>
                        <Label Text="Show cancelled jobs" VerticalOptions="Center"></Label>
                    </HorizontalStackLayout>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Text="Reset" Clicked="bnt_Clear_Filter_Clicked" Padding="14,6" CornerRadius="8"
                                ToolTipProperties.Text="Puts every filter back to how the page opens: the fortnight either side of today, no tag filter, cancelled work hidden"
                                BackgroundColor="Transparent" BorderWidth="2" BorderColor="{StaticResource MidGray}" TextColor="{StaticResource MidGray}"></Button>
                        <Button Grid.Column="1" Text="Done" Clicked="bnt_hideFilter" Padding="14,6" CornerRadius="8"
                                BackgroundColor="#2E7D32" TextColor="White" FontAttributes="Bold"></Button>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Viewing booking stuff-->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="jobOverviewBackground" BackgroundColor="Transparent">
                    <Label  Text="Due Work"
                        VerticalOptions="Center" 
                        HorizontalOptions="Start"
                        x:Name="t_job_overview"
                        FontSize="Small"
                        FontAttributes="Bold"
                        Scale="1"
                        Padding="4"
                    >
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="There are no jobs to display.
                                      
                                      Start creating jobs by clicking on the 'Add Job' button at the top of this screen. "></Span>
                                <Span Text="'Add Job'" TextColor="Green" FontAttributes="Bold"></Span>
                                <Span Text=" button at the top of this screen."></Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>


                </VerticalStackLayout>
                <Button x:Name="bnt_cancel_booking" Grid.Row="1" Grid.Column="0" Text="Cancel Booking" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Transparent" TextColor="Red" BorderColor="Red" BorderWidth="2" Padding="8"
                        Clicked="bnt_cancel_booking_clicked" IsVisible="false"
                        ></Button>
                <Button x:Name="bnt_reschedule_booking" Grid.Row="1" Grid.Column="1" Text="Reschedule Booking" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Transparent" TextColor="Orange" BorderColor="Orange" BorderWidth="2" Padding="8"
                        IsVisible="false" Clicked="bnt_reschedule_booking_Clicked"
                        ></Button>
            </Grid>
            <HorizontalStackLayout BackgroundColor="Transparent" x:Name="hsl_rescheduleDate" IsVisible="false">
                <Label Padding="8" Text="Reschedule Date" VerticalOptions="Center"></Label>
             <DatePicker x:Name="dp_rescedualDate" DateSelected="dp_dateSelected"></DatePicker>
                <Button Text="Reschedule" BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" HorizontalOptions="Center" VerticalOptions="Center" Padding="8" Clicked="bnt_ReschedualConfirm_Clicked"></Button>
            </HorizontalStackLayout>
            
        </VerticalStackLayout>

        <!--  Job more info stuff. Stacked above the list by default; moved into
              the side column by code when the window is wide enough -->
        <Grid BackgroundColor="#00796B" x:Name="g_more" IsVisible="false" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalOptions="Start" >
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Label x:Name="l_customerDescription" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="" FontAttributes="Bold" FontSize="Medium" BackgroundColor="#00695C"
                       VerticalOptions="CenterAndExpand" Padding="8" ></Label>
                <HorizontalStackLayout Grid.Row="1" Grid.Column="0" HorizontalOptions="Start">
                    <Label Text="Job Information:" VerticalOptions="Center" FontAttributes="Bold" Padding="4"  TextColor="{AppThemeBinding Dark=White, Light=Black}"></Label>
                    <Label x:Name="l_jobType" Margin="4" Padding="4" Text="" VerticalOptions="Center" FontAttributes="Bold"  TextColor="White"></Label>
                    <Label x:Name="l_jobPrice" Margin="4" Padding="4" Text="" VerticalOptions="Center" FontAttributes="Bold"  TextColor="White" ></Label>
                    <Label x:Name="l_jobOwed" Margin="4" Padding="4" VerticalOptions="Center" TextColor="{AppThemeBinding Dark=White, Light=Black}"></Label>
                    
                </HorizontalStackLayout>

                <HorizontalStackLayout x:Name="h_createAlterativePrice" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" HorizontalOptions="Center">
                        <Entry x:Name="e_alterativeName" Placeholder="Name" MinimumWidthRequest="200"></Entry>
                        <Entry x:Name="e_alterativePrice" Placeholder="Price" MinimumWidthRequest="100" Keyboard="Numeric"></Entry>
                    <Button Text="Add" Clicked="bnt_saveAlterativePrice" BorderWidth="2" BorderColor="{AppThemeBinding Dark=White, Light=Black}" TextColor="{AppThemeBinding Dark=White, Light=Black}" BackgroundColor="Transparent" FontAttributes="Bold"></Button>
                    <Button Text="X" Clicked="bnt_cancelAlterativePrice" BorderWidth="2" BorderColor="{AppThemeBinding Dark=White, Light=Black}" TextColor="{AppThemeBinding Dark=White, Light=Black}" BackgroundColor="Transparent" FontAttributes="Bold" TranslationX="2" ></Button>
                 </HorizontalStackLayout>
                
                <Button x:Name="bnt_addAlterativePrice" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"  Text="Add Alterative Price" Clicked="bnt_addAlterativePrice_Clicked" IsVisible="false"
                        BorderWidth="4"></Button>
                <HorizontalStackLayout x:Name="h_pick_alterativePrice" Grid.Row="2" Grid.Column="0" IsVisible="false">
                    <Label Text="Job Price" VerticalOptions="Center" FontAttributes="Bold" Padding="4"  TextColor="{AppThemeBinding Dark=White, Light=Black}"></Label>
                    <Picker VerticalOptions="Center" x:Name="p_priceToUse" SelectedIndexChanged="p_priceToUse_SelectedIndexChanged"></Picker>
                    
                </HorizontalStackLayout>
                <HorizontalStackLayout x:Name="h_pick_alterativePricebnt" Grid.Row="2" Grid.Column="2" HorizontalOptions="End" >
                    <Button x:Name="bnt_removeAlternatePayment" Text="Remove" BorderWidth="2" BorderColor="White" TextColor="{AppThemeBinding Dark=White, Light=Black}" BackgroundColor="Transparent"  Clicked="bnt_deleteAlternativePrice_Clicked" FontAttributes="Bold"></Button>
                    <Button Text="+" BorderWidth="2" BorderColor="{AppThemeBinding Dark=White, Light=Black}" TextColor="{AppThemeBinding Dark=White, Light=Black}" BackgroundColor="Transparent" Clicked="bnt_addAlterativePrice_Clicked" FontAttributes="Bold"></Button>
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Row="3" Grid.Column="0" HorizontalOptions="End">
                    <Label Text="Completed" VerticalOptions="Center" FontAttributes="Bold"  TextColor="White"></Label>
                    <CheckBox x:Name="cb_isCompleated" CheckedChanged="cb_IsCompleated_Changed" BackgroundColor="Transparent" ></CheckBox>
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2">
                    <Label x:Name="l_dateCompleated" Text="Date Completed"  VerticalOptions="Center" FontAttributes="Bold"  TextColor="White"></Label>
                    <DatePicker x:Name="p_dateCompleated"></DatePicker>
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Row="4" Grid.Column="0" HorizontalOptions="End">
                    <Label Text="Paid"  VerticalOptions="Center" FontAttributes="Bold"  TextColor="White"></Label>
                    <CheckBox x:Name="cb_isPaid" IsChecked="False" CheckedChanged="on_isPaid_Changed" BackgroundColor="Transparent" ></CheckBox>
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Row="4" Grid.Column="1">
                    <Label x:Name="l_currencyType" Text=""  VerticalOptions="Center" FontAttributes="Bold"  TextColor="White"></Label>
                    <Entry x:Name="l_amoutToPay" Text="" TextColor="{AppThemeBinding Dark=White, Light=Black}" ></Entry>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Row="4" Grid.Column="2">

                    <Picker x:Name="p_paymentType">
                        
                    </Picker>
                </HorizontalStackLayout>
                <Button Text="Cancel" Grid.Row="5" Grid.Column="0" Clicked="bnt_cancel_clicked" BorderWidth="2" BorderColor="White" TextColor="White" BackgroundColor="Transparent" FontAttributes="Bold"></Button>
                <Button Text="Confirm" Grid.Row="5" Grid.Column="2" Clicked="bnt_confirm_clicked" BorderWidth="2" BorderColor="White" TextColor="White" BackgroundColor="Transparent" FontAttributes="Bold"></Button>
        </Grid>

        <!-- shown for 10 seconds after cancelling a job from the list -->
        <Border x:Name="g_undoCancel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" IsVisible="false" BackgroundColor="#323232" StrokeThickness="0" StrokeShape="RoundRectangle 10" Margin="12,4" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Label Text="Job cancelled" TextColor="White" FontAttributes="Bold" VerticalOptions="Center"></Label>
                <Button Grid.Column="1" Text="Undo" Clicked="bnt_undoCancel_Clicked" BackgroundColor="Transparent" TextColor="{StaticResource PrimaryAccent}" Padding="8,2"></Button>
            </Grid>
        </Border>

        <CollectionView Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                    x:Name="lv_Jobs" SelectionMode="Single" SelectionChanged="lv_Jobs_SelectionChanged" VerticalOptions="FillAndExpand" RemainingItemsThreshold="0">
            <CollectionView.ItemTemplate>
                <DataTemplate >

                    <!-- a short drag opens the actions, so the list can be
                         worked one handed -->
                    <SwipeView x:Name="sv" SwipeStarted="swip_started" SwipeEnded="swip_ended" IsEnabled="{Binding EnabledSwipe}">

                        <SwipeView.LeftItems  >
                            <SwipeItems >
                                <SwipeItem Text="Done" 
                                    IconImageSource="tick.png"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="#4CAF50"
                                    Invoked="On_Job_Compleated"
                                           />
                                <SwipeItem Text="Done &amp; Paid"
                                    CommandParameter="{Binding Id}"
                                    IconImageSource="donepaid.png"
                                    BackgroundColor="#2E7D32"
                                    Invoked="On_Job_Paid" 
                                               />
                                <SwipeItem Text="More"
                                    IconImageSource="more.png"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="#546E7A"
                                    Invoked="On_Job_More" 
                                                   
                                               />
                            </SwipeItems>
                        </SwipeView.LeftItems>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Skip" 
                                    IconImageSource="skip.png"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="#FB8C00"
                                    Invoked="On_Job_Skipped"
                                           />
                                <SwipeItem Text="Cancel"
                                    IconImageSource="cancel.png"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="#E53935"
                                    Invoked="On_Job_Canceled" 
                                               />
                                <SwipeItem Text="Edit Details"
                                    IconImageSource="edit.png"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="#1E88E5"
                                    Invoked="On_Job_Detials"
                                               />
                                <SwipeItem Text="Expense"
                                    IconImageSource="payments.png"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="#7B1FA2"
                                    Invoked="On_Job_Expense"
                                               />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <!--            job list for jobs                              -->
                        
                        <Border BackgroundColor="{Binding AltColour}" StrokeThickness="0" StrokeShape="Rectangle" Margin="0">
                        <!-- holding a row starts picking jobs out, with that
                             one already picked -->
                        <Border.GestureRecognizers>
                            <PointerGestureRecognizer PointerPressed="Job_PointerPressed"
                                                      PointerMoved="Job_PointerMoved"
                                                      PointerReleased="Job_PointerReleased"
                                                      PointerExited="Job_PointerReleased"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout>
                            <!-- swipe gestures only work with touch, so desktop
                                 (right click) gets the same actions as a menu -->
                            <FlyoutBase.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="{Binding DoneActionText}" CommandParameter="{Binding Id}" Clicked="On_Job_Compleated" />
                                    <MenuFlyoutItem Text="Done &amp; Paid" CommandParameter="{Binding Id}" Clicked="On_Job_Paid" IsEnabled="{Binding ShowPaidAction}" />
                                    <MenuFlyoutItem Text="More" CommandParameter="{Binding Id}" Clicked="On_Job_More" />
                                    <MenuFlyoutItem Text="Tag" CommandParameter="{Binding Id}" Clicked="On_Job_Tag" />
                                    <MenuFlyoutItem Text="Do It Again" CommandParameter="{Binding Id}" Clicked="On_Job_DoAgain" IsEnabled="{Binding CanDoAgain}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Skip" CommandParameter="{Binding Id}" Clicked="On_Job_Skipped" />
                                    <MenuFlyoutItem Text="Cancel Job" CommandParameter="{Binding Id}" Clicked="On_Job_Canceled" />
                                    <MenuFlyoutItem Text="Edit Details" CommandParameter="{Binding Id}" Clicked="On_Job_Detials" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Add Expense" CommandParameter="{Binding Id}" Clicked="On_Job_Expense" />
                                </MenuFlyout>
                            </FlyoutBase.ContextFlyout>
                            <!-- cancelled jobs collapse to this greyed single line -->
                            <HorizontalStackLayout IsVisible="{Binding HaveCanceled}" Opacity="0.4" Padding="2">
                                <Label Text="{Binding JobFormattedHouseNumber}" FontAttributes="Bold" TextDecorations="Strikethrough" Padding="4,2" />
                                <Label Text="{Binding JobFormattedStreetOnly}" FontAttributes="Bold" TextDecorations="Strikethrough" Padding="4,2" />
                                <Label Text="{Binding JobFormattedCity}" TextDecorations="Strikethrough" Padding="4,2" />
                                <Label Text="Cancelled" TextColor="Red" FontAttributes="Bold" Padding="4,2" />
                            </HorizontalStackLayout>
                            <!-- one compact line per job, fixed column widths so
                                 the values line up like a spreadsheet -->
                            <!-- the address gets a line to itself: the tags used to
                                 sit beside it on fixed width columns that added up to
                                 more than a phone screen, which squeezed the street
                                 out of sight entirely -->
                            <Grid IsVisible="{Binding NotCanceled}" ColumnSpacing="2" Padding="2,3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    BackgroundColor="Transparent"
                                    Grid.Row="0" Grid.Column="0"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding SelectionModeEnabled}"
                                    IsChecked="{Binding IsSelected}"
                                    CheckedChanged="cb_streetSelected"  ClassId="{Binding Id}"></CheckBox>

                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding JobFormattedHouseNumber}" FontAttributes="Bold" VerticalOptions="Center" Padding="4,2" />

                                <!-- street takes whatever width is left and truncates
                                     rather than pushing anything off the row -->
                                <Grid Grid.Row="0" Grid.Column="2" ColumnSpacing="2" VerticalOptions="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Text="{Binding JobFormattedStreetOnly}" FontAttributes="Bold" Padding="4,2" VerticalOptions="Center" LineBreakMode="TailTruncation">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="Job_Street_Filter"></TapGestureRecognizer>
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label Grid.Column="1" Text="{Binding JobFormattedCity}" Padding="4,2" VerticalOptions="Center" LineBreakMode="TailTruncation">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="Job_City_Filter"></TapGestureRecognizer>
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label Grid.Column="2" Text="{Binding JobFormattedArea}" Padding="4,2" VerticalOptions="Center" LineBreakMode="TailTruncation">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="Job_Area_Filter"></TapGestureRecognizer>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>

                                <!-- an icon with no words to it, so it carries a
                                     tooltip: a long press brings it up on a
                                     phone, hovering does on a desktop -->
                                <ImageButton Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Source="info.png" HeightRequest="30" WidthRequest="30" Padding="4" CornerRadius="15" BackgroundColor="#1E88E5" HorizontalOptions="Center" VerticalOptions="Center" Clicked="bnt_info_Clicked"  ClassId="{Binding Id}"
                                             ToolTipProperties.Text="Everything about this job - price, notes, when it is due and who it is for"></ImageButton>

                                <!-- the job tags on their own line. fixed rows rather
                                     than a wrapping layout, so nothing depends on a
                                     measure pass that could collapse inside a list -->
                                <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4" Margin="0,2,0,0">
                                    <Label Text="{Binding Name}" IsVisible="{Binding HaveJobName}" FontAttributes="Bold" Padding="4,2" BackgroundColor="#EF6C00" TextColor="White" FontSize="12" LineBreakMode="TailTruncation">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="Job_Type_Filter"></TapGestureRecognizer>
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <Label Text="{Binding JobFormattedStringPrice}" FontAttributes="Bold" Padding="4,2" BackgroundColor="#2E7D32" TextColor="White" FontSize="12">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="Job_Price_Filter"></TapGestureRecognizer>
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <Label BackgroundColor="{Binding DueColorCode}" Text="{Binding JobFormattedDueTime}" TextColor="{Binding DueColorTextCode}" FontAttributes="Bold" Padding="4,2" FontSize="12"></Label>

                                    <Label IsVisible="{Binding ShowOwed}" BackgroundColor="{Binding OwedColorCode}" Text="{Binding JobFormattedOwed}" TextColor="White" FontAttributes="Bold" Padding="4,2" FontSize="12" LineBreakMode="TailTruncation">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="Money_Owed_Filter"></TapGestureRecognizer>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </HorizontalStackLayout>

                                <!-- the flags get a line of their own so a long one
                                     cannot push the others off the screen -->
                                <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4" Margin="0,2,0,0">
                                    <Label Text="One off" TextColor="White" BackgroundColor="#546E7A" IsVisible="{Binding ShowOneOff}" Padding="4,2" FontSize="12" FontAttributes="Bold"></Label>
                                    <Label Text="TNB" TextColor="White" BackgroundColor="#C62828" IsVisible="{Binding TNB}" Padding="4,2" FontSize="12" FontAttributes="Bold"></Label>
                                    <Label Text="ENB" TextColor="White" BackgroundColor="#C62828" IsVisible="{Binding ENB}" Padding="4,2" FontSize="12" FontAttributes="Bold"></Label>
                                    <!-- direct debit requested, waiting for the money to come through -->
                                    <Label Text="{Binding PaymentPendingText}" TextColor="White" BackgroundColor="#6A1B9A" IsVisible="{Binding PaymentPending}" Padding="4,2" FontSize="12" FontAttributes="Bold"></Label>
                                    <!-- what was different about this visit -->
                                    <Label Text="{Binding TagsText}" TextColor="White" BackgroundColor="#00838F" IsVisible="{Binding HaveTags}" Padding="4,2" FontSize="12" FontAttributes="Bold" LineBreakMode="TailTruncation"></Label>
                                </HorizontalStackLayout>

                                <!-- notes get their own line under the tags -->
                                <Label Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" BackgroundColor="#FB8C00" Text="{Binding JobFormattedStringNotes}" TextColor="White" Padding="4,2" IsVisible="{Binding HaveJobNotes}" LineBreakMode="TailTruncation" MaxLines="1" VerticalOptions="Center" HorizontalOptions="Start" Margin="0,2,0,0"></Label>
                            </Grid>
                        </VerticalStackLayout>
                        </Border>

                    </SwipeView>


                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
