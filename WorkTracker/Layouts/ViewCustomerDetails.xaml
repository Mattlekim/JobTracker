<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UiInterface.Layouts.ViewCustomerDetails"
             Title="Customer Details">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Edit Details" Priority="1" Clicked="tbi_EditDetails_Clicked"></ToolbarItem>
        <ToolbarItem x:Name="tbi_payPal" Text="Ask For Payment (PayPal)" Order="Secondary" Clicked="tbi_PayPal_Clicked"></ToolbarItem>
        <ToolbarItem x:Name="tbi_goCardless" Text="GoCardless (Experimental)" Order="Secondary" Clicked="tbi_GoCardless_Clicked"></ToolbarItem>
        <ToolbarItem x:Name="tbi_settle" Text="Settle Up (clear balance)" Order="Secondary" Clicked="tbi_Settle_Clicked"></ToolbarItem>
        <ToolbarItem x:Name="tbi_cancelJob" Text="Cancel Job" Order="Secondary" Clicked="tbi_Cancel_Job_Clicked"></ToolbarItem>
    </ContentPage.ToolbarItems>
    <StackLayout Padding="8">
        <Label Text="_________________________________" HorizontalOptions="Center"></Label>

        <Label></Label>

        <Grid Padding="8">
            <Border Stroke="{AppThemeBinding Light=black, Dark=white}" StrokeThickness="2" StrokeShape="Rectangle" Padding="4" >
                <VerticalStackLayout>

                    <VerticalStackLayout Padding="8" HorizontalOptions="Center">
                        <Label x:Name="l_customerName" Text="Customer Name" HorizontalOptions="Center"></Label>
                        <Label x:Name="l_customerAddressl1" Text="Customer AddressLine1" HorizontalOptions="Center"></Label>
                        <Label x:Name="l_customerAddressl2" Text="Customer AddressLine2" HorizontalOptions="Center"></Label>
                        <Label x:Name="l_customerAddressl3" Text="Customer AddressLine3" HorizontalOptions="Center"></Label>
                        <Label x:Name="l_customerAddressl4" Text="Customer AddressLine4" HorizontalOptions="Center"></Label>

                        <Label x:Name="l_email" Text="email" HorizontalOptions="Center" TextColor="Blue" Padding="4">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="l_emailClicked"></TapGestureRecognizer>
                            </Label.GestureRecognizers>
                        </Label>
                        
                        <Label x:Name="l_phone" Text="phone" HorizontalOptions="Center" TextColor="LightBlue" Padding="4">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="l_phoneClicked"></TapGestureRecognizer>
                            </Label.GestureRecognizers>
                        </Label>
                        
                    </VerticalStackLayout>
                    <HorizontalStackLayout Padding="8" HorizontalOptions="Center" Spacing="8">
                        <Label Text="Current Balance " VerticalOptions="Center"></Label>
                        <Label x:Name="l_owing" Text="{Binding Owing}" TextColor="{Binding OwingColour}" VerticalOptions="Center"></Label>
                        <Label x:Name="l_creditDebit" Text="{Binding CreditDebit}" VerticalOptions="Center"></Label>
                        <!-- a round taken over from somebody else starts with
                             whatever was owed written down somewhere else -->
                        <Button Text="Change" Clicked="bnt_changeBalance_Clicked" FontSize="12" Padding="12,2"
                                BackgroundColor="Transparent" BorderWidth="2" BorderColor="#1E88E5" TextColor="#1E88E5"
                                CornerRadius="8" VerticalOptions="Center"></Button>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>



        <!-- How this customer pays, and whatever that way of paying needs.
             Marking their work done then does it by itself rather than
             leaving it to be remembered -->
        <Border Stroke="{AppThemeBinding Light=black, Dark=white}" StrokeThickness="2" StrokeShape="Rectangle" Margin="8,0" Padding="10">
            <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="Pays by" VerticalOptions="Center" FontAttributes="Bold"></Label>
                    <Picker x:Name="p_paysBy" SelectedIndexChanged="p_paysBy_Changed" MinimumWidthRequest="140"></Picker>
                </HorizontalStackLayout>

                <!--  PAYPAL  -->
                <VerticalStackLayout x:Name="vsl_payPal" IsVisible="false" Spacing="2">
                    <Label Text="PayPal email (leave blank to use their normal email)" FontSize="12" TextColor="{StaticResource MidGray}"></Label>
                    <Entry x:Name="e_payPalEmail" Placeholder="their PayPal email" Keyboard="Email" TextChanged="e_payPalEmail_Changed"></Entry>
                    <Label x:Name="l_payPalState" FontSize="12" TextColor="{StaticResource MidGray}"></Label>
                </VerticalStackLayout>

                <!--  GOCARDLESS  -->
                <VerticalStackLayout x:Name="vsl_goCardless" IsVisible="false" Spacing="2">
                    <Label x:Name="l_gcState" FontSize="12" TextColor="{StaticResource MidGray}"></Label>
                    <HorizontalStackLayout Spacing="8">
                        <Button x:Name="bnt_gcLink" Text="Find In GoCardless" Clicked="bnt_gcLink_Clicked" FontSize="12" Padding="12,4" CornerRadius="8"
                                BackgroundColor="Transparent" BorderWidth="2" BorderColor="#1E88E5" TextColor="#1E88E5"></Button>
                        <Button x:Name="bnt_gcByHand" Text="Type It In" Clicked="bnt_gcByHand_Clicked" FontSize="12" Padding="12,4" CornerRadius="8"
                                BackgroundColor="Transparent" BorderWidth="2" BorderColor="{StaticResource MidGray}" TextColor="{StaticResource MidGray}"></Button>
                        <Button x:Name="bnt_gcUnlink" Text="Unlink" Clicked="bnt_gcUnlink_Clicked" IsVisible="false" FontSize="12" Padding="12,4" CornerRadius="8"
                                BackgroundColor="Transparent" BorderWidth="2" BorderColor="#E53935" TextColor="#E53935"></Button>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <Label x:Name="l_onDone" FontSize="12" TextColor="{StaticResource MidGray}"></Label>
            </VerticalStackLayout>
        </Border>

        <Label Text="_________________________________" HorizontalOptions="Center"></Label>
        <Label Text="History" FontAttributes="Bold" FontSize="Title" HorizontalOptions="Center"></Label>
        
        <CollectionView x:Name="cv_jobList" VerticalOptions="FillAndExpand" SelectionMode="Single">
            
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout BackgroundColor="{Binding AltColour}">
                        
                        <Grid Padding="4">
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>

                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <HorizontalStackLayout BackgroundColor="{Binding DateColour}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Padding="2">
                                <Label Text="{Binding JobDate}" TextColor="{Binding DueColorTextCode}" IsVisible="{Binding IsJob}" FontAttributes="Bold">
                                    
                                </Label>
                                <Label Text="{Binding PaymentDate}"  TextColor="{Binding DueColorTextCode}" IsVisible="{Binding IsPayment}" FontAttributes="Bold"></Label>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Padding="4">
                                <Label Text="{Binding FormattedLine1}"></Label>

                            </HorizontalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Padding="4">
                                <HorizontalStackLayout Padding="4" >
                                    <Label Text="{Binding FormattedLine2}" TextColor="White" BackgroundColor="Orange" Padding="2"></Label>

                                </HorizontalStackLayout>
                                <!-- what was different about this particular
                                     visit, which is the whole point of a tag -->
                                <HorizontalStackLayout IsVisible="{Binding HaveTags}" Padding="4">
                                    <Label Text="{Binding TagsText}" TextColor="White" BackgroundColor="#00838F" Padding="4,2" FontAttributes="Bold"></Label>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout  IsVisible="{Binding IsJob}" Padding="4">
                                    <Label Text="Notes: "></Label>
                                    <Label Text="{Binding Notes}" ></Label>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </StackLayout>

</ContentPage>
