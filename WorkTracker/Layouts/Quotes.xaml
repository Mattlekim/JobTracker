<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UiInterface.Layouts.Quotes"
             Title="Quotes">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="New Quote" IconImageSource="add.png" Clicked="bnt_newQuote_Clicked"></ToolbarItem>
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F2F4F7, Dark=#1E1E1E}" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="Caption" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- what is out at the moment, and what it comes to -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="12,12,12,0">
            <VerticalStackLayout Spacing="4">
                <Label x:Name="l_total" FontAttributes="Bold" FontSize="16"></Label>
                <Label Style="{StaticResource Caption}"
                       Text="Work that has been priced up but not taken on. A quote is not on the round and is not due - accepting one puts it on." />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="12" Spacing="12">
                <Label x:Name="l_empty" IsVisible="false" Padding="4,10"
                       Text="No quotes yet. New Quote at the top adds one, or tap a street on the Overview page and choose Quick Quote."></Label>
                <VerticalStackLayout x:Name="vsl_list" Spacing="12"></VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
