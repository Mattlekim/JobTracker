<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UiInterface.Layouts.JobStatus"
             Title="Job">

    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F2F4F7, Dark=#1E1E1E}" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="Caption" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="12" Spacing="12">

                <!--  WHICH JOB  -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="l_address" FontAttributes="Bold" FontSize="16"></Label>
                        <Label x:Name="l_jobType" Style="{StaticResource Caption}"></Label>
                        <Label x:Name="l_owed" FontAttributes="Bold"></Label>
                        <Label x:Name="l_pending" TextColor="#EF6C00" FontSize="12" IsVisible="false"></Label>
                    </VerticalStackLayout>
                </Border>

                <!--  PRICE  -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Price for this visit" Style="{StaticResource SectionTitle}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Picker Grid.Column="0" x:Name="p_priceToUse" SelectedIndexChanged="p_priceToUse_Changed"></Picker>
                            <Button Grid.Column="1" x:Name="bnt_addPrice" Text="Add" Clicked="bnt_addPrice_Clicked"
                                    BackgroundColor="Transparent" BorderWidth="2" BorderColor="#1E88E5" TextColor="#1E88E5" CornerRadius="8" Padding="12,4" FontSize="13"></Button>
                            <Button Grid.Column="2" x:Name="bnt_removePrice" Text="Remove" Clicked="bnt_removePrice_Clicked"
                                    BackgroundColor="Transparent" BorderWidth="2" BorderColor="#E53935" TextColor="#E53935" CornerRadius="8" Padding="12,4" FontSize="13" IsVisible="false"></Button>
                        </Grid>

                        <!-- adding another price this job can be charged at -->
                        <VerticalStackLayout x:Name="vsl_newPrice" IsVisible="false" Spacing="6">
                            <Entry x:Name="e_priceName" Placeholder="What it is for (e.g. Conservatory)"></Entry>
                            <Entry x:Name="e_priceAmount" Placeholder="Price" Keyboard="Numeric"></Entry>
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Save Price" Clicked="bnt_savePrice_Clicked" BackgroundColor="#2E7D32" TextColor="White" CornerRadius="8" Padding="14,6" FontSize="13"></Button>
                                <Button Text="Cancel" Clicked="bnt_cancelPrice_Clicked" BackgroundColor="Transparent" BorderWidth="2" BorderColor="#6B7280" TextColor="#6B7280" CornerRadius="8" Padding="14,6" FontSize="13"></Button>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!--  TAGS  -->
                <!-- what was different about this visit. it stays on this
                     visit only, so the customer's history shows which times
                     it was like that -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Tags for this visit" Style="{StaticResource SectionTitle}" />
                        <Label x:Name="l_noTags" Text="Nothing tagged on this one." Style="{StaticResource Caption}" />
                        <!-- fixed rows rather than a wrapping layout, so
                             nothing depends on a measure pass -->
                        <VerticalStackLayout x:Name="vsl_tags" Spacing="4"></VerticalStackLayout>
                        <Button Text="Add Tag" Clicked="bnt_addTag_Clicked" HorizontalOptions="Start"
                                BackgroundColor="Transparent" BorderWidth="2" BorderColor="#00838F" TextColor="#00838F" CornerRadius="8" Padding="14,6" FontSize="13"></Button>
                    </VerticalStackLayout>
                </Border>

                <!--  DONE  -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="cb_done" CheckedChanged="cb_done_Changed" VerticalOptions="Center"></CheckBox>
                            <Label Text="Done" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout x:Name="hsl_doneDate" Spacing="8">
                            <Label Text="on" VerticalOptions="Center" Style="{StaticResource Caption}" />
                            <DatePicker x:Name="dp_done"></DatePicker>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!--  PAID  -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="cb_paid" CheckedChanged="cb_paid_Changed" VerticalOptions="Center"></CheckBox>
                            <Label Text="Paid" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <VerticalStackLayout x:Name="vsl_paid" Spacing="10" IsVisible="false">

                            <Label Text="How much" Style="{StaticResource Caption}" />

                            <HorizontalStackLayout Spacing="8">
                                <RadioButton x:Name="rb_thisJob" GroupName="amount" CheckedChanged="AmountMode_Changed" VerticalOptions="Center"></RadioButton>
                                <Label x:Name="l_thisJob" VerticalOptions="Center"></Label>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="8">
                                <RadioButton x:Name="rb_everything" GroupName="amount" CheckedChanged="AmountMode_Changed" VerticalOptions="Center"></RadioButton>
                                <Label x:Name="l_everything" VerticalOptions="Center"></Label>
                            </HorizontalStackLayout>
                            <Label x:Name="l_everythingNote" Style="{StaticResource Caption}" Margin="34,-6,0,0" IsVisible="false"></Label>

                            <HorizontalStackLayout Spacing="8">
                                <RadioButton x:Name="rb_custom" GroupName="amount" CheckedChanged="AmountMode_Changed" VerticalOptions="Center"></RadioButton>
                                <Label Text="Some of it" VerticalOptions="Center"></Label>
                                <Label x:Name="l_currency" VerticalOptions="Center" FontAttributes="Bold"></Label>
                                <Entry x:Name="e_amount" Keyboard="Numeric" WidthRequest="110" TextChanged="e_amount_Changed"></Entry>
                            </HorizontalStackLayout>

                            <!--  PAID BY  -->
                            <!-- cash at the gate, a card, a cheque, a bank
                                 transfer - the picker names the method and
                                 the chip beside it says which one is set in
                                 the same colour the payments page uses -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Paid by" Style="{StaticResource Caption}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Picker Grid.Column="0" x:Name="p_paymentType" Title="Paid by" SelectedIndexChanged="p_paymentType_Changed"></Picker>
                                    <Border Grid.Column="1" x:Name="brd_method" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="6">
                                            <Image x:Name="i_method" HeightRequest="16" WidthRequest="16" VerticalOptions="Center"></Image>
                                            <Label x:Name="l_method" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"></Label>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>

                            <Label x:Name="l_paidLocked" Style="{StaticResource Caption}" TextColor="#EF6C00" IsVisible="false"></Label>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!--  ONE OFF  -->
                <!-- only there for a job with nothing to repeat. a job that
                     comes round on its own has nothing to say here -->
                <Border x:Name="brd_oneOff" Style="{StaticResource Card}" IsVisible="false">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="One off" Style="{StaticResource SectionTitle}" />
                        <Label x:Name="l_oneOff" Style="{StaticResource Caption}"></Label>
                        <Button x:Name="bnt_doAgain" Text="Do It Again" Clicked="bnt_doAgain_Clicked" IsVisible="false"
                                BackgroundColor="Transparent" BorderWidth="2" BorderColor="#1E88E5" TextColor="#1E88E5" CornerRadius="8" Padding="14,6" FontSize="13" HorizontalOptions="Start"></Button>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" Padding="12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Text="Cancel" Clicked="bnt_cancel_Clicked"
                    BackgroundColor="Transparent" BorderWidth="2" BorderColor="#6B7280" TextColor="#6B7280" CornerRadius="8" Padding="16,8"></Button>
            <Button Grid.Column="1" Text="Save" Clicked="bnt_save_Clicked"
                    BackgroundColor="#2E7D32" TextColor="White" FontAttributes="Bold" CornerRadius="8" Padding="16,8"></Button>
        </Grid>
    </Grid>

</ContentPage>
