<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UiInterface.Layouts.SettingLayout"
             Title="Setting">

    <ContentPage.Resources>
        <!-- the tappable heading of each settings section -->
        <Style x:Key="SectionHeader" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F2F4F7, Dark=#1E1E1E}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=White}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="ContentLayout" Value="Left,0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </ContentPage.Resources>

    <ScrollView x:Name="sv_mainScrole" VerticalScrollBarVisibility="Always" Margin="5">
        <VerticalStackLayout Padding="6">

            <!-- version and build details, filled in from the app itself so
                 they can never go stale -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="14" Margin="0,4,0,10"
                    BackgroundColor="{AppThemeBinding Light=#F2F4F7, Dark=#1E1E1E}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Work Tracker" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center"></Label>
                    <Label x:Name="l_appVersion" HorizontalOptions="Center" TextColor="Grey"></Label>
                    <Label x:Name="l_appReleased" HorizontalOptions="Center" TextColor="Grey" FontSize="12"></Label>
                </VerticalStackLayout>
            </Border>

            <!--  JOBS  -->
            <Button Text="▸ Jobs" ClassId="sec_jobs" Style="{StaticResource SectionHeader}" Clicked="Section_Clicked"></Button>
            <VerticalStackLayout x:Name="sec_jobs" IsVisible="false" Padding="10,0,10,10">
                <Label Text="Default New Job Settings"  VerticalOptions="Center" TranslationY="8" BackgroundColor="{AppThemeBinding Light=white, Dark=black}" HorizontalOptions="Start" TranslationX="4" ></Label>
                <Border Stroke="{AppThemeBinding Light=black, Dark=white}" StrokeThickness="2" StrokeShape="Rectangle" TranslationX="0" Padding="4">
                    <VerticalStackLayout>
                        <HorizontalStackLayout>
                            <Label Text="Default new job frequence" VerticalOptions="Center"></Label>
                            <Entry x:Name="e_defaultFrequence" Keyboard="Numeric" MinimumWidthRequest="40"></Entry>
                            <Picker x:Name="p_frequencyType" >
                                <Picker.Items>
                                    <x:String>Day</x:String>
                                    <x:String>Week</x:String>
                                    <x:String>Month</x:String>
                                    <x:String>Year</x:String>
                                </Picker.Items>
                            </Picker>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout>
                            <Label Text="Default new job duration (in minutes)" VerticalOptions="Center"></Label>
                            <Entry x:Name="e_defaultDuration" MinimumWidthRequest="40" Keyboard="Numeric"></Entry>
                        </HorizontalStackLayout>
                        <Label></Label>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Customize Job Settings"  VerticalOptions="Center" TranslationY="8" BackgroundColor="{AppThemeBinding Light=white, Dark=black}" HorizontalOptions="Start" TranslationX="4" ></Label>
                <Border Stroke="{AppThemeBinding Light=black, Dark=white}" StrokeThickness="2" StrokeShape="Rectangle" TranslationX="0" Padding="4">
                    <VerticalStackLayout>
                        <Label Text="Job Names"></Label>
                        <ListView x:Name="l_jobNames" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <!-- the cross takes it off the list it is
                                             picked from, and only when nothing is
                                             carrying it -->
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"></ColumnDefinition>
                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <Entry Grid.Column="0" Text="{Binding Name}" ClassId="{Binding Index}" TextChanged="e_textChanged"></Entry>
                                            <Button Grid.Column="1" Text="✕" ClassId="{Binding Index}" Clicked="bnt_deleteJobType" FontAttributes="Bold"
                                                    BackgroundColor="Transparent" TextColor="#C62828" BorderColor="#C62828" BorderWidth="2"
                                                    CornerRadius="8" Padding="10,0" MinimumWidthRequest="40" VerticalOptions="Center"
                                                    ToolTipProperties.Text="Take this job type off the list"></Button>
                                        </Grid>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>
                        <Button Text="Add Job Type"  BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" Padding="8" Clicked="bnt_addJobType"></Button>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Job Tags"  VerticalOptions="Center" TranslationY="8" BackgroundColor="{AppThemeBinding Light=white, Dark=black}" HorizontalOptions="Start" TranslationX="4" ></Label>
                <Border Stroke="{AppThemeBinding Light=black, Dark=white}" StrokeThickness="2" StrokeShape="Rectangle" TranslationX="0" Padding="4">
                    <VerticalStackLayout>
                        <!-- only the list offered when something is being
                             tagged. what a visit was actually tagged with is
                             kept on that visit, so taking a tag off here never
                             changes a day already worked -->
                        <Label Text="Offered when you tag a job or a day's work. A tag says what that time of doing the job was like, and stays on that visit only."></Label>
                        <ListView x:Name="l_tagNames" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <!-- the cross takes it off the list it is
                                             picked from, and only when nothing is
                                             carrying it -->
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"></ColumnDefinition>
                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <Entry Grid.Column="0" Text="{Binding Name}" ClassId="{Binding Index}" TextChanged="e_tagTextChanged"></Entry>
                                            <Button Grid.Column="1" Text="✕" ClassId="{Binding Index}" Clicked="bnt_deleteTag" FontAttributes="Bold"
                                                    BackgroundColor="Transparent" TextColor="#C62828" BorderColor="#C62828" BorderWidth="2"
                                                    CornerRadius="8" Padding="10,0" MinimumWidthRequest="40" VerticalOptions="Center"
                                                    ToolTipProperties.Text="Take this tag off the list"></Button>
                                        </Grid>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>
                        <Button Text="Add Tag"  BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" Padding="8" Clicked="bnt_addTag"></Button>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Rounds"  VerticalOptions="Center" TranslationY="8" BackgroundColor="{AppThemeBinding Light=white, Dark=black}" HorizontalOptions="Start" TranslationX="4" ></Label>
                <Border Stroke="{AppThemeBinding Light=black, Dark=white}" StrokeThickness="2" StrokeShape="Rectangle" TranslationX="0" Padding="4">
                    <VerticalStackLayout>
                        <!-- only the list to pick from. taking a round off it
                             does not take the work off that round - the round
                             is on the job -->
                        <Label Text="Split the work into rounds - a patch, a village, a day of the week, whatever yours is actually split into. Work is listed round by round, and can be filtered down to one."></Label>
                        <ListView x:Name="l_roundNames" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <!-- the cross takes it off the list it is
                                             picked from, and only when nothing is
                                             carrying it -->
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"></ColumnDefinition>
                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <Entry Grid.Column="0" Text="{Binding Name}" ClassId="{Binding Index}" TextChanged="e_roundTextChanged"></Entry>
                                            <Button Grid.Column="1" Text="✕" ClassId="{Binding Index}" Clicked="bnt_deleteRound" FontAttributes="Bold"
                                                    BackgroundColor="Transparent" TextColor="#C62828" BorderColor="#C62828" BorderWidth="2"
                                                    CornerRadius="8" Padding="10,0" MinimumWidthRequest="40" VerticalOptions="Center"
                                                    ToolTipProperties.Text="Take this round off the list"></Button>
                                        </Grid>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>
                        <Button Text="Add Round"  BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" Padding="8" Clicked="bnt_addRound"></Button>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!--  PAPER VIEW  -->
            <Button Text="▸ Paper View" ClassId="sec_paper" Style="{StaticResource SectionHeader}" Clicked="Section_Clicked"></Button>
            <VerticalStackLayout x:Name="sec_paper" IsVisible="false" Padding="10,0,10,10">
                <Label Text="Symbol Settings"  VerticalOptions="Center" TranslationY="10" BackgroundColor="{AppThemeBinding Light=white, Dark=black}" HorizontalOptions="Start" TranslationX="4" ></Label>
                <Border Stroke="{AppThemeBinding Light=black, Dark=white}" StrokeThickness="2" StrokeShape="Rectangle" TranslationX="0" Padding="4">
                    <VerticalStackLayout Padding="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="0.2*"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>

                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="1" Text="Done" VerticalTextAlignment="Center"></Label>
                            <Entry  Grid.Row="0" Grid.Column="2" x:Name="e_pv_done" MinimumWidthRequest="10" VerticalOptions="Center" MaxLength="1"></Entry>

                            <Label Grid.Row="1" Grid.Column="1" Text="Paid"  VerticalOptions="Center"></Label>
                            <Entry Grid.Row="1" Grid.Column="2" x:Name="e_pv_paid"  VerticalOptions="Center" MinimumWidthRequest="10" MaxLength="1"></Entry>

                            <Label Grid.Row="2" Grid.Column="1" Text="Done &amp; Paid"  VerticalOptions="Center"></Label>
                            <Entry Grid.Row="2" Grid.Column="2" x:Name="e_pv_donepaid"  VerticalOptions="Center" MinimumWidthRequest="10" MaxLength="1"></Entry>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!--  RECEIPT PHOTOS  -->
            <Button Text="▸ Receipt Photos" ClassId="sec_receipts" Style="{StaticResource SectionHeader}" Clicked="Section_Clicked"></Button>
            <VerticalStackLayout x:Name="sec_receipts" IsVisible="false" Padding="10,0,10,10">
                <Label Text="Receipt photos are scaled down and saved as JPEGs before they are stored, so a shoebox full of receipts does not fill the phone up, get backed up and synced at full camera size. They stay readable at every setting." TextColor="Grey"></Label>
                <Label></Label>
                <Label Text="Photo size"></Label>
                <Picker x:Name="p_photoQuality" SelectedIndexChanged="p_photoQuality_Changed"></Picker>
                <Label x:Name="l_photoQualityDetail" TextColor="Grey" FontSize="13"></Label>
                <Label></Label>
                <Label x:Name="l_receiptStorage" TextColor="Grey"></Label>
                <Label></Label>
                <Button x:Name="bnt_recompressPhotos" Text="Shrink Photos Already Saved" BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" Clicked="bnt_recompressPhotos_Clicked"></Button>
            </VerticalStackLayout>

            <!--  DATA  -->
            <Button Text="▸ Data, Backup and Import" ClassId="sec_data" Style="{StaticResource SectionHeader}" Clicked="Section_Clicked"></Button>
            <VerticalStackLayout x:Name="sec_data" IsVisible="false" Padding="10,0,10,10">
                <Button Text="Create Backup" BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" Clicked="bnt_createBackup_Clicked"></Button>
                <Label></Label>
                <Button Text="Restore From Backup" BackgroundColor="Transparent" TextColor="Orange" BorderColor="Orange" BorderWidth="2" Clicked="bnt_restorBackup_Clicked"></Button>
                <Label></Label>
                <Button Text="Import Customers From Excel" BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" Clicked="bnt_importXlsx_Clicked"></Button>
                <Label></Label>
                <Button Text="Export Round To Excel" BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" Clicked="bnt_exportXlsx_Clicked"></Button>
                <Label></Label>
                <Button Text="Reset Banking Import Settings"  BackgroundColor="Transparent" BorderWidth="2" BorderColor="Green" TextColor="Green" Clicked="bnt_resetImportBanking"></Button>
                <Label></Label>
                <!-- puts duplicate customer records back into one. see
                     Layouts/TidyCustomers for why there are any -->
                <Button x:Name="bnt_tidyCustomers" Text="Tidy Customers" BackgroundColor="Transparent" BorderWidth="2" BorderColor="Green" TextColor="Green" Clicked="bnt_tidyCustomers_Clicked"></Button>
                <Label x:Name="l_tidyCustomers" FontSize="12" TextColor="#EF6C00" IsVisible="false"></Label>
                <Label></Label>
                <Button Text="Delete All Data" BackgroundColor="Transparent" TextColor="Red" BorderColor="Red" BorderWidth="2" Clicked="bnt_deleteData_Clicked"></Button>
            </VerticalStackLayout>

            <!--  CLOUD SYNC  -->
            <!-- not finished yet, so the whole section is shown greyed out and
                 nothing in it can be pressed. taking it out altogether would
                 only have people looking for it -->
            <Button Text="▸ Cloud Sync (Coming Soon)" ClassId="sec_cloud" Style="{StaticResource SectionHeader}" Clicked="Section_Clicked" TextColor="Grey"></Button>
            <VerticalStackLayout x:Name="sec_cloud" IsVisible="false" IsEnabled="false" Opacity="0.5" Padding="10,0,10,10">
                <Label Text="COMING SOON" FontAttributes="Bold" FontSize="12" TextColor="Grey" HorizontalOptions="Start"></Label>
                <Label Text="Cloud sync is not ready yet - it is coming in a later update. Until then use Create Backup under Data, Backup and Import to move your round between devices." TextColor="Grey"></Label>
                <Label></Label>
                <Label Text="Sync your data with Google Drive so your phone and PC share the same round. Sign in once on each device." TextColor="Grey"></Label>
                <Label></Label>

                <!-- shown until signed in -->
                <VerticalStackLayout x:Name="vsl_cloudSetup">
                    <Label x:Name="l_cloudSignInHint" Text="Press Connect and a browser window will open for you to log in to Google and authorise the app."></Label>
                    <!-- only shown when the app was built without its own google
                         credentials and they have to be supplied by hand -->
                    <VerticalStackLayout x:Name="vsl_cloudClientFields">
                        <Label Text="Paste the Client ID and Client Secret from your Google Cloud project (OAuth client type: 'Desktop app')."></Label>
                        <Entry x:Name="e_cloudClientId" Placeholder="Client ID"></Entry>
                        <Entry x:Name="e_cloudClientSecret" Placeholder="Client Secret" IsPassword="True"></Entry>
                    </VerticalStackLayout>
                    <Label></Label>
                    <Button Text="Connect Google Drive" BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" Clicked="bnt_cloudConnect_Clicked"></Button>
                </VerticalStackLayout>

                <!-- shown when signed in -->
                <VerticalStackLayout x:Name="vsl_cloudConnected" IsVisible="false">
                    <HorizontalStackLayout>
                        <Label Text="Auto sync" VerticalOptions="Center"></Label>
                        <Switch x:Name="sw_cloudAuto" Toggled="sw_cloudAuto_Toggled"></Switch>
                    </HorizontalStackLayout>
                    <Label x:Name="l_cloudStatus" Text="" TextColor="Grey"></Label>
                    <Label></Label>
                    <Button Text="Sync Now" BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" Clicked="bnt_cloudSyncNow_Clicked"></Button>
                    <Label></Label>
                    <Button Text="Disconnect" BackgroundColor="Transparent" TextColor="Red" BorderColor="Red" BorderWidth="2" Clicked="bnt_cloudDisconnect_Clicked"></Button>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!--  GOCARDLESS  -->
            <!--  PAYPAL  -->
            <Button Text="▸ PayPal" ClassId="sec_paypal" Style="{StaticResource SectionHeader}" Clicked="Section_Clicked"></Button>
            <VerticalStackLayout x:Name="sec_paypal" IsVisible="false" Padding="10,0,10,10">
                <Label Text="Send a customer a link that opens PayPal with the amount already filled in. Nothing to connect and no keys to paste - just your paypal.me name." TextColor="Grey"></Label>
                <Label></Label>
                <HorizontalStackLayout Spacing="2">
                    <Label Text="paypal.me/" VerticalOptions="Center" FontAttributes="Bold"></Label>
                    <Entry x:Name="e_paypalHandle" Placeholder="your name" MinimumWidthRequest="160" TextChanged="e_paypalHandle_Changed"></Entry>
                </HorizontalStackLayout>
                <Label x:Name="l_paypalExample" FontSize="12" TextColor="{StaticResource MidGray}"></Label>
                <Label></Label>
                <Label Text="Set it up at paypal.me if you have not already. Sending the link does not mark anything as paid - the money is recorded when it lands, off your PayPal statement." FontSize="12" TextColor="{StaticResource MidGray}"></Label>
            </VerticalStackLayout>

            <Button Text="▸ GoCardless (Experimental)" ClassId="sec_gocardless" Style="{StaticResource SectionHeader}" Clicked="Section_Clicked"></Button>
            <VerticalStackLayout x:Name="sec_gocardless" IsVisible="false" Padding="10,0,10,10">
                <Label Text="EXPERIMENTAL" FontAttributes="Bold" FontSize="12" TextColor="White" BackgroundColor="#EF6C00" Padding="8,2" HorizontalOptions="Start"></Label>
                <Label Text="Direct debits are still being worked on. Check anything you collect against your GoCardless dashboard before relying on it." TextColor="#EF6C00" FontSize="13"></Label>
                <Label></Label>
                <Label Text="Collect payments by direct debit with GoCardless. Link each customer to their direct debit from the customer details page, then take payments with one tap." TextColor="Grey"></Label>
                <Label></Label>

                <!-- shown until connected -->
                <VerticalStackLayout x:Name="vsl_gcSetup">
                    <Label Text="Paste an access token from your GoCardless dashboard (Developers -> Create -> Access token, with read-write access)."></Label>
                    <Entry x:Name="e_gcToken" Placeholder="Access token" IsPassword="True"></Entry>
                    <HorizontalStackLayout>
                        <Label Text="Use sandbox (testing)" VerticalOptions="Center"></Label>
                        <Switch x:Name="sw_gcSandbox"></Switch>
                    </HorizontalStackLayout>
                    <Label></Label>
                    <Button Text="Connect GoCardless" BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" Clicked="bnt_gcConnect_Clicked"></Button>
                </VerticalStackLayout>

                <!-- shown when connected -->
                <VerticalStackLayout x:Name="vsl_gcConnected" IsVisible="false">
                    <Label x:Name="l_gcStatus" Text="Connected" TextColor="Grey"></Label>
                    <Label x:Name="l_gcPending" Text="" TextColor="Grey"></Label>
                    <Label></Label>

                    <!-- how GoCardless charges for its fees, which decides
                         whether they can be picked up automatically -->
                    <Label Text="Fees" FontAttributes="Bold"></Label>
                    <HorizontalStackLayout>
                        <Label Text="Custom pricing (fees invoiced)" VerticalOptions="Center"></Label>
                        <Switch x:Name="sw_gcCustomPricing" Toggled="sw_gcCustomPricing_Toggled"></Switch>
                    </HorizontalStackLayout>
                    <Label x:Name="l_gcPricingHint" Text="" TextColor="Grey"></Label>
                    <Label></Label>
                    <Button Text="Check Pending Payments" BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" Clicked="bnt_gcCheck_Clicked"></Button>
                    <Label></Label>
                    <Button Text="Disconnect" BackgroundColor="Transparent" TextColor="Red" BorderColor="Red" BorderWidth="2" Clicked="bnt_gcDisconnect_Clicked"></Button>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!--  MESSAGES  -->
            <Button Text="▸ Messages" ClassId="sec_messages" Style="{StaticResource SectionHeader}" Clicked="Section_Clicked"></Button>
            <VerticalStackLayout x:Name="sec_messages" IsVisible="false" Padding="10,0,10,10">
                <Grid TranslationY="4">
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Grid.Row="0" Text="Customize Messages"  VerticalOptions="Center" TranslationY="8" BackgroundColor="{AppThemeBinding Light=white, Dark=black}" HorizontalOptions="Start" TranslationX="4" ></Label>
                    <Button Grid.Column="1" Grid.Row="0" Text="Help?" VerticalOptions="Center" TranslationY="4" Padding="4" BackgroundColor="{AppThemeBinding Light=white, Dark=#121212}" TranslationX="-4" HorizontalOptions="End"
                                Clicked="bnt_messagesHelp_Clicked"></Button>
                </Grid>
                <Border Stroke="{AppThemeBinding Light=black, Dark=white}" StrokeThickness="2" StrokeShape="Rectangle" TranslationX="0" Padding="4">
                    <VerticalStackLayout>
                        <VerticalStackLayout Padding="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.78*"></ColumnDefinition>
                                    <ColumnDefinition Width="0.22*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Row="0" Grid.Column="0" Text="Night Before Message" VerticalOptions="Center" Padding="4" ></Label>
                                <Button Grid.Row="0" Grid.Column="1" Text="Preview" BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" Padding="8" Clicked="bnt_previewTNB"></Button>
                            </Grid>
                            <Editor x:Name="e_DefaultTNB" Margin="0,0,0,0" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Start" MinimumHeightRequest="100" MinimumWidthRequest="300"></Editor>
                        </VerticalStackLayout>

                        <VerticalStackLayout Padding="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.78*"></ColumnDefinition>
                                    <ColumnDefinition Width="0.22*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label  Grid.Row="0" Grid.Column="0" Text="After Job Completion Message" VerticalOptions="Center" Padding="4 "></Label>
                                <Button Grid.Row="0" Grid.Column="1" Text="Preview" BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" Padding="8"  Clicked="bnt_previewTAC"></Button>
                            </Grid>
                            <Editor x:Name="e_DefaultTAC" Margin="0,0,0,0" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Start" MinimumHeightRequest="100" MinimumWidthRequest="300" ></Editor>
                        </VerticalStackLayout>

                        <VerticalStackLayout Padding="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.78*"></ColumnDefinition>
                                    <ColumnDefinition Width="0.22*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label  Grid.Row="0" Grid.Column="0" Text="Message To Reschadule" VerticalOptions="Center" Padding="4"></Label>
                                <Button Grid.Row="0" Grid.Column="1" Text="Preview" BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" Padding="8"  Clicked="bnt_previewRearange"></Button>
                            </Grid>
                            <Editor x:Name="e_DefaultRearange" Margin="0,0,0,0" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Start" MinimumHeightRequest="100" MinimumWidthRequest="300"></Editor>
                        </VerticalStackLayout>

                        <VerticalStackLayout Padding="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.79*"></ColumnDefinition>
                                    <ColumnDefinition Width="0.22*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label  Grid.Row="0" Grid.Column="0" Text="Message To Say Not Coming" VerticalOptions="Center" Padding="4"></Label>
                                <Button Grid.Row="0" Grid.Column="1" Text="Preview" BackgroundColor="Transparent" TextColor="Green" BorderColor="Green" BorderWidth="2" Padding="8" Clicked="bnt_previewNotComming"></Button>
                            </Grid>
                            <Editor x:Name="e_DefaultNotComming" Margin="0,0,0,0" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Start" MinimumHeightRequest="100" MinimumWidthRequest="300"></Editor>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!--  DEBUG  -->
            <Button Text="&#x25B8; Debug" ClassId="sec_debug" Style="{StaticResource SectionHeader}" Clicked="Section_Clicked"></Button>
            <VerticalStackLayout x:Name="sec_debug" IsVisible="false" Padding="10,0,10,10">
                <Label Text="Screenshot Mode"  VerticalOptions="Center" TranslationY="8" BackgroundColor="{AppThemeBinding Light=white, Dark=black}" HorizontalOptions="Start" TranslationX="4" ></Label>
                <Border Stroke="{AppThemeBinding Light=black, Dark=white}" StrokeThickness="2" StrokeShape="Rectangle" Padding="4">
                    <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="6">
                            <CheckBox x:Name="cb_screenshotMode" IsChecked="false" CheckedChanged="cb_screenshotMode_Changed" VerticalOptions="Center"></CheckBox>
                            <Label Text="Made up road and town names" FontAttributes="Bold" VerticalOptions="Center"></Label>
                        </HorizontalStackLayout>
                        <Label Text="For photographing the round without putting a customer's address in front of everybody. House numbers stay as they are; every road, town, area and postcode is swapped for a made up one, the same one each time, so the round still reads as a round."
                               FontSize="12" TextColor="{StaticResource MidGray}"></Label>
                        <Label Text="It only changes what is on the screen - nothing saved, exported or sent to a customer is touched - and it is deliberately not remembered, so it is off again the next time the app starts."
                               FontSize="12" TextColor="{StaticResource MidGray}"></Label>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
