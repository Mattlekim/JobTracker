<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WorkTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UiInterface.Layouts"
    Shell.FlyoutBehavior="Disabled">

    <TabBar >

        <!-- somebody else's work list, sent over as a .rwk and opened with
             a PIN. only on show while extra work is on the phone. this one
             leads the tab bar while extra work is being done; the shortcut
             with the same squeegee at the far end is the way in from the
             normal tabs - see AppShell.xaml.cs -->
        <Tab Title="Extra Work"
            Icon="squeegee.png"
            x:Name="tab_extraWork"
            IsVisible="false">
            <ShellContent ContentTemplate="{DataTemplate local:ExtraWork}"/>
        </Tab>
        <!-- the way back out of extra work. it is a gate rather than the
             work itself: landing on it asks about leaving, because getting
             back in means the PIN again -->
        <Tab Title="My Work"
            Icon="work.png"
            x:Name="tab_myWork"
            IsVisible="false">
            <ShellContent ContentTemplate="{DataTemplate local:MyWorkGate}"/>
        </Tab>

        <Tab Title="Customers"
            Icon="person.png">
            <ShellContent  ContentTemplate="{DataTemplate local:Customers}" IsVisible="false"/>
        </Tab>
        <Tab Title="Jobs"
            Icon="work.png">
            <ShellContent ContentTemplate="{DataTemplate local:JobsList}" IsVisible="False"/>
        </Tab>
        <Tab Title="Work"
            Icon="work.png"
            x:Name="tab_work">
            <!-- the route stays work_overview: it is what the WorkTabView
                 preference has been written as all along, and renaming it
                 would lose which work view reopens for everybody already
                 using the app -->
            <ShellContent Title="Paper" Route="work_overview" x:Name="sc_workOverview" ContentTemplate="{DataTemplate local:PaperView}"/>
            <ShellContent Title="List" Route="work_list" x:Name="sc_workList" ContentTemplate="{DataTemplate local:WorkPlanner}"/>
            <!-- the whole round rather than the work in hand: every job once,
                 grouped by round, area, town and street. The work list only
                 reaches a fortnight ahead and the job list keeps every visit
                 of a house, so neither of them says what you have got -->
            <ShellContent Title="All Jobs" Route="work_all" x:Name="sc_workAll" ContentTemplate="{DataTemplate local:AllJobs}"/>
            <!-- priced up but not taken on. kept off the round and off the
                 work list, because a quote is not due and cannot be done -->
            <ShellContent Title="Quotes" Route="work_quotes" x:Name="sc_workQuotes" ContentTemplate="{DataTemplate local:Quotes}"/>
            <ShellContent Title="Stats" Route="work_stats" x:Name="sc_workStats" ContentTemplate="{DataTemplate local:Stats}"/>
        </Tab>
        <Tab Title="Booked" x:Name="tab_booked"
            Icon="booked.png">
            <ShellContent ContentTemplate="{DataTemplate local:BookedWork}" />
        </Tab>
        <Tab Title="Calendar"
            Icon="planner.png"
            x:Name="tab_calendar">
            <ShellContent ContentTemplate="{DataTemplate local:CalenderView}" />
        </Tab>
        <!-- money in, money out and the tax figures share one tab: android's
             bottom bar only shows five, and anything past that disappears
             behind a More tab -->
        <!-- while extra work is on the phone this tab is retitled More and
             settings joins it as a fourth page, which is what keeps the bar
             at five tabs with the squeegee on the end - android only shows
             five, and a sixth would push the squeegee behind a More of the
             platform's own making. RefreshShareTabs does the renaming -->
        <Tab Title="Money"
            Icon="payments.png"
            x:Name="tab_money">
            <ShellContent Title="Payments" Route="money_payments" x:Name="sc_moneyPayments" ContentTemplate="{DataTemplate local:Payments}" />
            <ShellContent Title="Expenses" Route="money_expenses" ContentTemplate="{DataTemplate local:Expenses}" />
            <ShellContent Title="Tax" Route="money_tax" ContentTemplate="{DataTemplate local:TaxView}" />
            <!-- what a Universal Credit claim has to be told each month.
                 off unless the round is on a claim (Settings.ShowUniversalCredit,
                 put up and taken down by RefreshUniversalCreditTab) -->
            <ShellContent Title="Universal Credit" Route="money_universalcredit" x:Name="sc_moneyUniversalCredit" ContentTemplate="{DataTemplate local:UniversalCreditView}" IsVisible="false" />
            <ShellContent Title="Settings" x:Name="sc_moneySettings" ContentTemplate="{DataTemplate local:SettingLayout}" IsVisible="false"/>
        </Tab>
        <Tab Title="Settings"
            Icon="options.png"
            x:Name="tab_settings">
            <ShellContent ContentTemplate="{DataTemplate local:SettingLayout}" />
        </Tab>

        <!-- the squeegee at the end of the normal tabs, the way back into
             extra work. only on show while extra work is on the phone and
             the normal tabs are up - and it takes the settings tab's slot
             when it is (settings moves under More, above), so it really is
             the bottom right corner of the bar rather than behind More -->
        <Tab Title="Extra Work"
            Icon="squeegee.png"
            x:Name="tab_extraShortcut"
            IsVisible="false">
            <ShellContent ContentTemplate="{DataTemplate local:ExtraWork}"/>
        </Tab>

    </TabBar>
</Shell>
