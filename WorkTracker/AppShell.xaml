<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WorkTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UiInterface.Layouts"
    Shell.FlyoutBehavior="Disabled">

    <TabBar >

        <Tab Title="Customers"
            Icon="person.png">
            <ShellContent  ContentTemplate="{DataTemplate local:Customers}" IsVisible="false"/>
        </Tab>
        <Tab Title="Jobs"
            Icon="work.png">
            <ShellContent ContentTemplate="{DataTemplate local:JobsList}" IsVisible="False"/>
        </Tab>
        <Tab Title="Work"
            Icon="work.png"
            x:Name="tab_work">
            <!-- the route stays work_overview: it is what the WorkTabView
                 preference has been written as all along, and renaming it
                 would lose which work view reopens for everybody already
                 using the app -->
            <ShellContent Title="Paper" Route="work_overview" x:Name="sc_workOverview" ContentTemplate="{DataTemplate local:PaperView}"/>
            <ShellContent Title="List" Route="work_list" x:Name="sc_workList" ContentTemplate="{DataTemplate local:WorkPlanner}"/>
            <!-- the whole round rather than the work in hand: every job once,
                 grouped by round, area, town and street. The work list only
                 reaches a fortnight ahead and the job list keeps every visit
                 of a house, so neither of them says what you have got -->
            <ShellContent Title="All Jobs" Route="work_all" x:Name="sc_workAll" ContentTemplate="{DataTemplate local:AllJobs}"/>
            <!-- priced up but not taken on. kept off the round and off the
                 work list, because a quote is not due and cannot be done -->
            <ShellContent Title="Quotes" Route="work_quotes" x:Name="sc_workQuotes" ContentTemplate="{DataTemplate local:Quotes}"/>
            <ShellContent Title="Stats" Route="work_stats" x:Name="sc_workStats" ContentTemplate="{DataTemplate local:Stats}"/>
        </Tab>
        <Tab Title="Booked" x:Name="tab_booked"
            Icon="booked.png">
            <ShellContent ContentTemplate="{DataTemplate local:BookedWork}" />
        </Tab>
        <Tab Title="Calendar"
            Icon="planner.png"
             >
            <ShellContent ContentTemplate="{DataTemplate local:CalenderView}" />
        </Tab>
        <!-- money in, money out and the tax figures share one tab: android's
             bottom bar only shows five, and anything past that disappears
             behind a More tab -->
        <Tab Title="Money"
            Icon="payments.png">
            <ShellContent Title="Payments" Route="money_payments" ContentTemplate="{DataTemplate local:Payments}" />
            <ShellContent Title="Expenses" Route="money_expenses" ContentTemplate="{DataTemplate local:Expenses}" />
            <ShellContent Title="Tax" Route="money_tax" ContentTemplate="{DataTemplate local:TaxView}" />
        </Tab>
        <Tab Title="Settings"
            Icon="options.png"
             >
            <ShellContent ContentTemplate="{DataTemplate local:SettingLayout}" />
        </Tab>

    </TabBar>
</Shell>
