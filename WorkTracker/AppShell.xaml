<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WorkTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UiInterface.Layouts"
    Shell.FlyoutBehavior="Disabled">

    <TabBar >

        <Tab Title="Customers"
            Icon="person.png">
            <ShellContent  ContentTemplate="{DataTemplate local:Customers}" IsVisible="false"/>
        </Tab>
        <Tab Title="Jobs"
            Icon="work.png">
            <ShellContent ContentTemplate="{DataTemplate local:JobsList}" IsVisible="False"/>
        </Tab>
        <Tab Title="Work"
            Icon="work.png"
            x:Name="tab_work">
            <ShellContent Title="Overview" Route="work_overview" x:Name="sc_workOverview" ContentTemplate="{DataTemplate local:PaperView}"/>
            <ShellContent Title="List" Route="work_list" x:Name="sc_workList" ContentTemplate="{DataTemplate local:WorkPlanner}"/>
        </Tab>
        <Tab Title="Booked" x:Name="tab_booked"
            Icon="booked.png">
            <ShellContent ContentTemplate="{DataTemplate local:BookedWork}" />
        </Tab>
        <Tab Title="Calendar"
            Icon="planner.png"
             >
            <ShellContent ContentTemplate="{DataTemplate local:CalenderView}" />
        </Tab>
        <!-- money in, money out and the tax figures share one tab: android's
             bottom bar only shows five, and anything past that disappears
             behind a More tab -->
        <Tab Title="Money"
            Icon="payments.png">
            <ShellContent Title="Payments" Route="money_payments" ContentTemplate="{DataTemplate local:Payments}" />
            <ShellContent Title="Expenses" Route="money_expenses" ContentTemplate="{DataTemplate local:Expenses}" />
            <ShellContent Title="Tax" Route="money_tax" ContentTemplate="{DataTemplate local:TaxView}" />
        </Tab>
        <Tab Title="Settings"
            Icon="options.png"
             >
            <ShellContent ContentTemplate="{DataTemplate local:SettingLayout}" />
        </Tab>

    </TabBar>
</Shell>
